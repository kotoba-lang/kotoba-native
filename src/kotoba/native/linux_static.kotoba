;; Complete canonical Linux-static packager composition. Unqualified source.
(ns kotoba.native.linux-static
  {:kotoba/export [package plan targets image-layout slot-names implemented-slots]}
  (:require [kotoba.artifact.data :as meta]
            [kotoba.artifact.form-seal :as artifact]
            [kotoba.object.elf64 :as elf]
            [kotoba.native.linux-static-plan :as planning]
            [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-prelude :as prelude]
            [kotoba.native.linux-static-context :as context])
  (:schemas
   {:linux.static.image/result
    [:record :linux.static.image/result
     [[:bytes :vector-i64] [:value [:ref :form/r]] [:error :keyword] [:data [:ref :form/r]]]]
    :linux.static.image/decisions
    [:record :linux.static.image/decisions
     [[:bytes :vector-i64] [:labels [:list [:ref :linux.static/label]]] [:regions [:ref :form/r]]
      [:error :keyword] [:data [:ref :form/r]]]]
    :linux.static.image/build
    [:record :linux.static.image/build
     [[:text :vector-i64] [:context :vector-i64] [:layout [:ref :form/r]] [:details [:ref :form/r]]
      [:error :keyword] [:data [:ref :form/r]]]]}))

(defn targets [] [:ref :form/r] (planning/targets))
(defn implemented-slots [] [:ref :form/r] (planning/implemented-slots))
(defn slot-names [abi [:ref :form/r]] [:ref :linux.static.plan/result] (planning/slot-names abi))
(defn plan [source [:ref :form/r] profile [:ref :form/r] overrides [:ref :form/r]] [:ref :linux.static.plan/result]
  (planning/plan source profile overrides))
(defn image-layout [text-size :i64 source-plan [:ref :form/r]] [:ref :linux.static.plan/result]
  (planning/image-layout text-size source-plan))
(defn- text-base [] :i64 4198400)
(defn- assembly-limit [] :i64 (- 9223372036854775807 (text-base)))
(defn- lookup [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
  (if (not= (meta/value-kind m) :map) (meta/value-null)
    (loop [index 0]
      (if (= index (meta/value-count m)) (meta/value-null)
        (let [pair (option-value-of [:option [:ref :form/r]] (meta/value-map-entry-at m index) (meta/value-null))]
          (if (meta/value-equal? (option-value-of [:option [:ref :form/r]] (meta/value-vector-at pair 0) (meta/value-null)) key)
            (option-value-of [:option [:ref :form/r]] (meta/value-vector-at pair 1) (meta/value-null)) (recur (+ index 1))))))))
(defn- get-key [m [:ref :form/r] key :keyword] [:ref :form/r] (lookup m (meta/value-keyword key)))
(defn- item [v [:ref :form/r] index :i64] [:ref :form/r]
  (if (= (meta/value-kind v) :list)
    (option-value-of [:option [:ref :form/r]] (meta/value-list-at v index) (meta/value-null))
    (option-value-of [:option [:ref :form/r]] (meta/value-vector-at v index) (meta/value-null))))
(defn- i64-of [d [:ref :form/r]] :i64 (option-value-of [:option :i64] (meta/value-i64-value d) -1))
(defn- key-of [d [:ref :form/r]] :keyword (option-value-of [:option :keyword] (meta/value-keyword-value d) :none))
(defn- true? [d [:ref :form/r]] :bool (meta/value-equal? d (meta/value-bool true)))
(defn- detail [stage :keyword field :keyword] [:ref :form/r]
  (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :stage) (meta/value-keyword stage))
      (meta/value-map-insert (meta/value-keyword :field) (meta/value-keyword field))))
(defn- ok [bytes :vector-i64] [:ref :linux.static.image/result]
  (record-new [:ref :linux.static.image/result] bytes (meta/value-null) :ok (meta/value-null)))
(defn- fail [error :keyword data [:ref :form/r]] [:ref :linux.static.image/result]
  (record-new [:ref :linux.static.image/result] (vector-alloc 0) (meta/value-null) error data))
(defn- good? [r [:ref :linux.static.image/result]] :bool
  (= (record-get [:ref :linux.static.image/result] r :error) :ok))
(defn- bytes-of [r [:ref :linux.static.image/result]] :vector-i64
  (record-get [:ref :linux.static.image/result] r :bytes))
(defn- checked-add [a :i64 b :i64] :i64
  (if (or (< a 0) (< b 0) (> b (- 9223372036854775807 a))) -1 (+ a b)))
(defn- align-up [n :i64 alignment :i64] :i64
  (if (or (< n 0) (<= alignment 0)) -1
    (let [remainder (- n (* (quot n alignment) alignment))]
      (checked-add n (if (= remainder 0) 0 (- alignment remainder))))))
(defn- zeros [n :i64] :vector-i64
  (loop [index 0 out (vector-alloc 0)] (if (= index n) out (recur (+ index 1) (vector-conj out 0)))))
(defn- join [a :vector-i64 b :vector-i64] :vector-i64
  (let [left (vector-count a) right (vector-count b)
        allocated (vector-alloc (+ left right))]
    ;; The image can contain millions of bytes. One fresh owned destination
    ;; avoids creating a persistent vector root for every appended byte.
    (loop [index 0 out allocated]
      (if (= index (+ left right)) out
        (recur (+ index 1) (vector-assoc! out index
          (if (< index left) (vector-at a index) (vector-at b (- index left)))))))))
(defn- append-bytes [out [:ref :linux.static.image/result] more :vector-i64] [:ref :linux.static.image/result]
  (if (not (good? out)) out
    (if (< (checked-add (vector-count (bytes-of out)) (vector-count more)) 0) (fail :image-overflow (detail :frame :bytes))
      (ok (join (bytes-of out) more)))))
(defn- from-elf [r [:ref :kotoba.object.elf64/result] stage :keyword] [:ref :linux.static.image/result]
  (if (not= (record-get [:ref :kotoba.object.elf64/result] r :error) :ok)
    (fail (record-get [:ref :kotoba.object.elf64/result] r :error)
      (detail stage (record-get [:ref :kotoba.object.elf64/result] r :field)))
    (ok (record-get [:ref :kotoba.object.elf64/result] r :bytes))))
(defn- append-elf [out [:ref :linux.static.image/result] more [:ref :kotoba.object.elf64/result] stage :keyword]
  [:ref :linux.static.image/result]
  (if (not (good? out)) out
    (let [r (from-elf more stage)] (if (good? r) (append-bytes out (bytes-of r)) r))))
(defn- pad-result [out [:ref :linux.static.image/result] size :i64 stage :keyword] [:ref :linux.static.image/result]
  (if (not (good? out)) out (from-elf (elf/pad-to (bytes-of out) size) stage)))
(defn- normalized-code [value [:ref :form/r] field :keyword] [:ref :linux.static.image/result]
  (if (= (meta/value-kind value) :bytes)
    (let [bytes (option-value-of [:option :bytes] (meta/value-bytes-value value) (bytes-empty))]
      (loop [index 0 out (vector-alloc (bytes-count bytes))]
        (if (= index (bytes-count bytes)) (ok out)
          (recur (+ index 1) (vector-assoc! out index (bytes-at bytes index))))))
    (if (not (or (= (meta/value-kind value) :vector) (= (meta/value-kind value) :list))) (fail :artifact-code (detail :code field))
      (loop [index 0 out (vector-alloc (meta/value-count value))]
        (if (= index (meta/value-count value)) (ok out)
          (let [byte (item value index)]
            (if (not= (meta/value-kind byte) :i64) (fail :artifact-code (detail :code field))
              (recur (+ index 1) (vector-assoc! out index (bit-and (i64-of byte) 255))))))))))
(defn- address [labels [:list [:ref :linux.static/label]] name :string] :i64
  (loop [index 0]
    (if (= index (vector-count labels)) -1
      (let [row (typed-list-nth [:list [:ref :linux.static/label]] labels index)]
        (if (string=? (record-get [:ref :linux.static/label] row :name) name)
          (record-get [:ref :linux.static/label] row :address) (recur (+ index 1)))))))
(defn- external-labels [labels [:list [:ref :linux.static/label]] main :i64] [:list [:ref :linux.static/label]]
  (typed-list-conj [:list [:ref :linux.static/label]] labels (asm/label "ls/guest-main" main)))
(defn- add-label [labels [:list [:ref :linux.static/label]] name :string value :i64] [:list [:ref :linux.static/label]]
  (typed-list-conj [:list [:ref :linux.static/label]] labels (asm/label name value)))
(defn- decision-fail [error :keyword data [:ref :form/r]] [:ref :linux.static.image/decisions]
  (record-new [:ref :linux.static.image/decisions] (vector-alloc 0)
    (typed-list-new [:list [:ref :linux.static/label]]) (meta/value-vector) error data))
(defn- symbol-offset [component [:ref :form/r] name :string size :i64] :i64
  (let [offset (lookup (get-key component :offsets) (meta/value-symbol name))]
    (if (and (= (meta/value-kind offset) :i64) (>= (i64-of offset) 0) (< (i64-of offset) size)) (i64-of offset) -1)))
(defn- decision-text [source-plan [:ref :form/r] code-end :i64] [:ref :linux.static.image/decisions]
  (if (not (true? (get-key source-plan :handlers?)))
    (record-new [:ref :linux.static.image/decisions] (vector-alloc 0)
      (typed-list-new [:list [:ref :linux.static/label]]) (meta/value-vector) :ok (meta/value-null))
    (let [pair (get-key source-plan :handler-code) decisions (get-key pair :decisions) handlers (get-key pair :handlers)
          dr (normalized-code (get-key decisions :code) :decisions) hr (normalized-code (get-key handlers :code) :handlers)]
      (cond
        (not (good? dr)) (decision-fail (record-get [:ref :linux.static.image/result] dr :error) (record-get [:ref :linux.static.image/result] dr :data))
        (not (good? hr)) (decision-fail (record-get [:ref :linux.static.image/result] hr :error) (record-get [:ref :linux.static.image/result] hr :data))
        :else
        (let [dsize (vector-count (bytes-of dr)) hsize (vector-count (bytes-of hr))
              c1 (align-up code-end 16) dend (checked-add c1 dsize) h (align-up dend 16) end (checked-add h hsize)
              cap (symbol-offset decisions "cap-admitted" dsize) decide (symbol-offset decisions "decide" dsize)
              handle (symbol-offset handlers "decide" hsize)]
          (cond
            (or (< c1 0) (< dend 0) (< h 0) (< end 0)) (decision-fail :layout-overflow (detail :decisions :end))
            (or (< cap 0) (< decide 0) (< handle 0)) (decision-fail :handler-export (detail :decisions :offsets))
            :else
            (let [bytes (join (join (join (zeros (- c1 code-end)) (bytes-of dr)) (zeros (- h dend))) (bytes-of hr))
                  labels (-> (typed-list-new [:list [:ref :linux.static/label]])
                             (add-label "ls.cap/c1-code-base" c1)
                             (add-label "ls.cap/h-code-base" h)
                             (add-label "ls.cap/c1-cap" (+ c1 cap))
                             (add-label "ls.cap/c1-decide" (+ c1 decide))
                             (add-label "ls.cap/h-decide" (+ h handle)))
                  regions (-> (meta/value-vector)
      (meta/value-vector-conj (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :which) (meta/value-keyword :decisions))
      (meta/value-map-insert (meta/value-keyword :address) (meta/value-i64 c1))
      (meta/value-map-insert (meta/value-keyword :size) (meta/value-i64 dsize))))
      (meta/value-vector-conj (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :which) (meta/value-keyword :handlers))
      (meta/value-map-insert (meta/value-keyword :address) (meta/value-i64 h))
      (meta/value-map-insert (meta/value-keyword :size) (meta/value-i64 hsize)))))]
              (record-new [:ref :linux.static.image/decisions] bytes labels regions :ok (meta/value-null)))))))))
(defn- build-fail [error :keyword data [:ref :form/r]] [:ref :linux.static.image/build]
  (record-new [:ref :linux.static.image/build] (vector-alloc 0) (vector-alloc 0) (meta/value-null) (meta/value-null) error data))
(defn- finish-build [isa :keyword source-plan [:ref :form/r] layout [:ref :form/r] guest :vector-i64 main-offset :i64
                     prelude-size :i64 decisions [:ref :linux.static.image/decisions]] [:ref :linux.static.image/build]
  (let [body (prelude/routine isa source-plan layout)
        code-address (+ (text-base) prelude-size) main-address (+ code-address main-offset)]
    (if (not= (record-get [:ref :linux.static.prelude/result] body :error) :ok)
      (build-fail (record-get [:ref :linux.static.prelude/result] body :error) (detail :prelude :final))
      (let [assembled (asm/assemble isa (text-base) (record-get [:ref :linux.static.prelude/result] body :code)
                        (external-labels (record-get [:ref :linux.static.image/decisions] decisions :labels) main-address) (assembly-limit))
            labels (record-get [:ref :linux.static/result] assembled :labels)
            prelude (record-get [:ref :linux.static/result] assembled :bytes) entry (address labels "ls/start")]
        (cond
          (not= (record-get [:ref :linux.static/result] assembled :error) :ok)
          (build-fail (record-get [:ref :linux.static/result] assembled :error)
            (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :stage) (meta/value-keyword :assembly-final))
      (meta/value-map-insert (meta/value-keyword :at) (meta/value-i64 (record-get [:ref :linux.static/result] assembled :at)))))
          (or (not= (vector-count prelude) prelude-size) (not= (address labels "ls/text-end") code-address))
          (build-fail :prelude-size (detail :assembly-final :text-end))
          (or (< entry (text-base)) (>= entry code-address)) (build-fail :entry-span (detail :assembly-final :start))
          :else
          (let [initialized (context/context-bytes source-plan layout labels
                              (record-get [:ref :linux.static.prelude/result] body :bindings) code-address (vector-count guest))]
            (if (not= (record-get [:ref :linux.static.context/result] initialized :error) :ok)
              (build-fail (record-get [:ref :linux.static.context/result] initialized :error) (detail :context :initialized))
              (record-new [:ref :linux.static.image/build]
                (join (join prelude guest) (record-get [:ref :linux.static.image/decisions] decisions :bytes))
                (record-get [:ref :linux.static.context/result] initialized :bytes) layout
                (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :entry-address) (meta/value-i64 entry))
      (meta/value-map-insert (meta/value-keyword :main-address) (meta/value-i64 main-address))
      (meta/value-map-insert (meta/value-keyword :prelude-size) (meta/value-i64 prelude-size))
      (meta/value-map-insert (meta/value-keyword :code-size) (meta/value-i64 (vector-count guest)))
      (meta/value-map-insert (meta/value-keyword :decision-regions) (record-get [:ref :linux.static.image/decisions] decisions :regions)))
                :ok (meta/value-null)))))))))
(defn- build-after-probe [isa :keyword source-plan [:ref :form/r] guest :vector-i64 main-offset :i64 probe [:ref :linux.static/result]]
  [:ref :linux.static.image/build]
  (let [size (vector-count (record-get [:ref :linux.static/result] probe :bytes))
        code-address (checked-add (text-base) size) code-end (checked-add code-address (vector-count guest))]
    (cond
      (or (< code-address 0) (< code-end 0)) (build-fail :layout-overflow (detail :probe :code-end))
      (not= (address (record-get [:ref :linux.static/result] probe :labels) "ls/text-end") code-address)
      (build-fail :prelude-size (detail :probe :text-end))
      :else
      (let [decisions (decision-text source-plan code-end)]
        (if (not= (record-get [:ref :linux.static.image/decisions] decisions :error) :ok)
          (build-fail (record-get [:ref :linux.static.image/decisions] decisions :error)
            (record-get [:ref :linux.static.image/decisions] decisions :data))
          (let [text-size (checked-add (checked-add size (vector-count guest))
                            (vector-count (record-get [:ref :linux.static.image/decisions] decisions :bytes)))]
            (if (< text-size 0) (build-fail :layout-overflow (detail :layout :text-size))
              (let [layout (planning/image-layout text-size source-plan)]
                (if (not= (record-get [:ref :linux.static.plan/result] layout :error) :ok)
                  (build-fail (record-get [:ref :linux.static.plan/result] layout :error)
                    (record-get [:ref :linux.static.plan/result] layout :data))
                  (finish-build isa source-plan (record-get [:ref :linux.static.plan/result] layout :value)
                    guest main-offset size decisions))))))))))
(defn- build [isa :keyword source-plan [:ref :form/r] guest :vector-i64 main-offset :i64] [:ref :linux.static.image/build]
  (let [layout (planning/image-layout 0 source-plan)]
    (if (not= (record-get [:ref :linux.static.plan/result] layout :error) :ok)
      (build-fail (record-get [:ref :linux.static.plan/result] layout :error) (record-get [:ref :linux.static.plan/result] layout :data))
      (let [body (prelude/routine isa source-plan (record-get [:ref :linux.static.plan/result] layout :value))
            decisions (decision-text source-plan (text-base))]
        (cond
          (not= (record-get [:ref :linux.static.prelude/result] body :error) :ok)
          (build-fail (record-get [:ref :linux.static.prelude/result] body :error) (detail :prelude :probe))
          (not= (record-get [:ref :linux.static.image/decisions] decisions :error) :ok)
          (build-fail (record-get [:ref :linux.static.image/decisions] decisions :error)
            (record-get [:ref :linux.static.image/decisions] decisions :data))
          :else
          (let [probe (asm/assemble isa (text-base) (record-get [:ref :linux.static.prelude/result] body :code)
                        (external-labels (record-get [:ref :linux.static.image/decisions] decisions :labels) (text-base)) (assembly-limit))]
            (if (not= (record-get [:ref :linux.static/result] probe :error) :ok)
              (build-fail (record-get [:ref :linux.static/result] probe :error)
                (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :stage) (meta/value-keyword :assembly-probe))
      (meta/value-map-insert (meta/value-keyword :at) (meta/value-i64 (record-get [:ref :linux.static/result] probe :at)))))
              (build-after-probe isa source-plan guest main-offset probe))))))))

(defn- section [name-offset :i64 type :keyword flags :i64 address :i64 offset :i64 size :i64 alignment :i64]
  [:ref :kotoba.object.elf64/result]
  (elf/encode-section-header
    (meta/value-to-document (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :name-offset) (meta/value-i64 name-offset))
      (meta/value-map-insert (meta/value-keyword :type) (meta/value-keyword type))
      (meta/value-map-insert (meta/value-keyword :flags) (meta/value-i64 flags))
      (meta/value-map-insert (meta/value-keyword :address) (meta/value-i64 address))
      (meta/value-map-insert (meta/value-keyword :offset) (meta/value-i64 offset))
      (meta/value-map-insert (meta/value-keyword :size) (meta/value-i64 size))
      (meta/value-map-insert (meta/value-keyword :alignment) (meta/value-i64 alignment))))))
(defn- program-header [type [:ref :form/r] flags :i64 offset :i64 address :i64 file-size :i64 memory-size :i64 alignment :i64]
  [:ref :kotoba.object.elf64/result]
  (elf/encode-program-header
    (meta/value-to-document (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :type) type)
      (meta/value-map-insert (meta/value-keyword :flags) (meta/value-i64 flags))
      (meta/value-map-insert (meta/value-keyword :offset) (meta/value-i64 offset))
      (meta/value-map-insert (meta/value-keyword :virtual-address) (meta/value-i64 address))
      (meta/value-map-insert (meta/value-keyword :file-size) (meta/value-i64 file-size))
      (meta/value-map-insert (meta/value-keyword :memory-size) (meta/value-i64 memory-size))
      (meta/value-map-insert (meta/value-keyword :alignment) (meta/value-i64 alignment))))))
(defn- utf8 [text :string] :vector-i64
  (let [bytes (string-to-utf8 text)]
    (loop [index 0 out (vector-alloc 0)]
      (if (= index (bytes-count bytes)) out (recur (+ index 1) (vector-conj out (bytes-at bytes index)))))))
(defn- frame [machine :keyword built [:ref :linux.static.image/build]] [:ref :linux.static.image/result]
  (let [layout (record-get [:ref :linux.static.image/build] built :layout) details (record-get [:ref :linux.static.image/build] built :details)
        text (record-get [:ref :linux.static.image/build] built :text) context (record-get [:ref :linux.static.image/build] built :context)
        text-offset (i64-of (get-key layout :text-offset)) text-address (i64-of (get-key layout :text))
        data-offset (i64-of (get-key layout :data-offset)) data-address (i64-of (get-key layout :data))
        memory-size (i64-of (get-key layout :memory-size)) names (utf8 "\u0000.text\u0000.data\u0000.bss\u0000.shstrtab\u0000")
        initialized-size (context/initialized-size)
        names-offset (checked-add data-offset initialized-size) section-offset (align-up (checked-add names-offset (vector-count names)) 8)
        end (checked-add section-offset 320)]
    (cond
      (or (< names-offset 0) (< section-offset 0) (< end 0)) (fail :image-overflow (detail :frame :section-offset))
      (or (not= text-offset 4096) (not= text-address (text-base)) (< data-offset text-offset)
          (> (vector-count text) (- data-offset text-offset)) (not= (vector-count context) initialized-size) (< memory-size 4096)
          (< data-address 0) (> memory-size (- 9223372036854775807 data-address))) (fail :layout-input (detail :frame :regions))
      :else
      (let [header (elf/encode-header
                     (meta/value-to-document (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :type) (meta/value-keyword :executable))
      (meta/value-map-insert (meta/value-keyword :machine) (meta/value-keyword machine))
      (meta/value-map-insert (meta/value-keyword :entry) (get-key details :entry-address))
      (meta/value-map-insert (meta/value-keyword :program-header-offset) (meta/value-i64 64))
      (meta/value-map-insert (meta/value-keyword :program-header-count) (meta/value-i64 3))
      (meta/value-map-insert (meta/value-keyword :section-header-offset) (meta/value-i64 section-offset))
      (meta/value-map-insert (meta/value-keyword :section-header-count) (meta/value-i64 5))
      (meta/value-map-insert (meta/value-keyword :section-name-index) (meta/value-i64 4)))))
            bytes (-> (from-elf header :header)
                      (append-elf (program-header (meta/value-keyword :load) 5 text-offset text-address (vector-count text) (vector-count text) 4096) :text-program)
                      (append-elf (program-header (meta/value-keyword :load) 6 data-offset data-address initialized-size memory-size 4096) :data-program)
                      (append-elf (program-header (meta/value-i64 1685382481) 6 0 0 0 0 16) :stack-program)
                      (pad-result text-offset :before-text) (append-bytes text) (pad-result data-offset :before-data)
                      (append-bytes context) (append-bytes names) (pad-result section-offset :before-sections)
                      (append-bytes (zeros 64))
                      (append-elf (section 1 :progbits 6 text-address text-offset (vector-count text) 16) :text-section)
                      (append-elf (section 7 :progbits 3 data-address data-offset initialized-size 16) :data-section)
                      (append-elf (section 13 :nobits 3 (+ data-address 4096) names-offset (- memory-size 4096) 16) :bss-section)
                      (append-elf (section 18 :strtab 0 0 names-offset (vector-count names) 1) :names-section))]
        (if (and (good? bytes) (not= (vector-count (bytes-of bytes)) end))
          (fail :image-size (detail :frame :end)) bytes)))))
(defn- slot-states [slots [:ref :form/r]] [:ref :form/r]
  (loop [index 0 out (meta/value-map)]
    (if (= index (meta/value-count slots)) out
      (let [pair (option-value-of [:option [:ref :form/r]] (meta/value-map-entry-at slots index) (meta/value-null))]
        (recur (+ index 1) (meta/value-merge out (-> (meta/value-map)
      (meta/value-map-insert (item pair 0) (meta/value-keyword (if (true? (get-key (item pair 1) :admitted?)) :implemented :traps))))))))))
(defn- file-regions [regions [:ref :form/r]] [:ref :form/r]
  (loop [index 0 out (meta/value-vector)]
    (if (= index (meta/value-count regions)) out
      (let [row (item regions index) offset (+ 4096 (- (i64-of (get-key row :address)) (text-base)))]
        (recur (+ index 1) (meta/value-vector-conj out (meta/value-merge row
          (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :address) (meta/value-i64 offset))))))))))
(defn- metadata [source [:ref :form/r] source-plan [:ref :form/r] built [:ref :linux.static.image/build]] [:ref :form/r]
  (let [details (record-get [:ref :linux.static.image/build] built :details) layout (record-get [:ref :linux.static.image/build] built :layout)]
    (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :format) (meta/value-keyword :elf64/v1))
      (meta/value-map-insert (meta/value-keyword :target) (get-key source :target))
      (meta/value-map-insert (meta/value-keyword :entry) (meta/value-keyword :_start))
      (meta/value-map-insert (meta/value-keyword :entry-address) (get-key details :entry-address))
      (meta/value-map-insert (meta/value-keyword :source-entry) (get-key (get-key source :program) :entry))
      (meta/value-map-insert (meta/value-keyword :main-address) (get-key details :main-address))
      (meta/value-map-insert (meta/value-keyword :text-offset) (get-key layout :text-offset))
      (meta/value-map-insert (meta/value-keyword :prelude-size) (get-key details :prelude-size))
      (meta/value-map-insert (meta/value-keyword :code-offset) (meta/value-i64 (+ (i64-of (get-key layout :text-offset)) (i64-of (get-key details :prelude-size)))))
      (meta/value-map-insert (meta/value-keyword :code-size) (get-key details :code-size))
      (meta/value-map-insert (meta/value-keyword :data-offset) (get-key layout :data-offset))
      (meta/value-map-insert (meta/value-keyword :data-address) (get-key layout :data))
      (meta/value-map-insert (meta/value-keyword :budgets) (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :cells) (get-key source-plan :cells))
      (meta/value-map-insert (meta/value-keyword :bytes) (get-key source-plan :bytes))
      (meta/value-map-insert (meta/value-keyword :vectors) (get-key source-plan :vectors))
      (meta/value-map-insert (meta/value-keyword :vector-items) (get-key source-plan :vector-items))
      (meta/value-map-insert (meta/value-keyword :vector-item-limit) (get-key source-plan :vector-item-limit))
      (meta/value-map-insert (meta/value-keyword :byte-value-limit) (get-key source-plan :byte-value-limit))
      (meta/value-map-insert (meta/value-keyword :string-value-limit) (get-key source-plan :string-value-limit))))
      (meta/value-map-insert (meta/value-keyword :fuel) (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :initial) (get-key source-plan :fuel))
      (meta/value-map-insert (meta/value-keyword :metered) (get-key source-plan :metered?))))
      (meta/value-map-insert (meta/value-keyword :slots) (slot-states (get-key source-plan :slots)))
      (meta/value-map-insert (meta/value-keyword :sections) (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-keyword :text))
      (meta/value-vector-conj (meta/value-keyword :data))
      (meta/value-vector-conj (meta/value-keyword :bss))
      (meta/value-vector-conj (meta/value-keyword :shstrtab))))
      (meta/value-map-insert (meta/value-keyword :imports) (meta/value-vector))
      (meta/value-map-insert (meta/value-keyword :interpreter) (meta/value-null))
      (meta/value-map-insert (meta/value-keyword :dynamic) (meta/value-null))
      (meta/value-map-insert (meta/value-keyword :grant) (get-key source-plan :grant))
      (meta/value-map-insert (meta/value-keyword :fs-scope) (get-key source-plan :fs-scope))
      (meta/value-map-insert (meta/value-keyword :spawn) (get-key source-plan :spawn))
      (meta/value-map-insert (meta/value-keyword :decision-code) (file-regions (get-key details :decision-regions))))))
(defn- package-planned [source [:ref :form/r] source-plan [:ref :form/r] target [:ref :form/r] code :vector-i64 main-offset :i64]
  [:ref :linux.static.image/result]
  (let [built (build (key-of (get-key target :isa)) source-plan code main-offset)]
    (if (not= (record-get [:ref :linux.static.image/build] built :error) :ok)
      (fail (record-get [:ref :linux.static.image/build] built :error) (record-get [:ref :linux.static.image/build] built :data))
      (let [framed (frame (key-of (get-key target :machine)) built)]
        (if (not (good? framed)) framed
          (record-new [:ref :linux.static.image/result] (bytes-of framed) (metadata source source-plan built) :ok (meta/value-null)))))))

(defn package [source [:ref :form/r] profile [:ref :form/r] overrides [:ref :form/r]] [:ref :linux.static.image/result]
  (cond
    (or (not= (meta/value-kind source) :map) (not (artifact/valid-seal? source))) (fail :unsealed (detail :admission :artifact))
    :else
    (let [target (lookup (planning/targets) (get-key source :target))
          entry (get-key (get-key source :program) :entry) export (lookup (get-key source :exports) entry)]
      (cond
        (not= (meta/value-kind target) :map) (fail :not-linux-static (detail :admission :target))
        (or (not= (meta/value-kind export) :map) (not (meta/value-equal? (get-key export :arity) (meta/value-i64 0))))
        (fail :entry-not-zero-arity (detail :admission :entry))
        :else
        (let [code (normalized-code (get-key source :code) :guest) offset (get-key export :offset)]
          (cond
            (not (good? code)) code
            (or (not= (meta/value-kind offset) :i64) (< (i64-of offset) 0) (>= (i64-of offset) (vector-count (bytes-of code))))
            (fail :entry-span (detail :admission :offset))
            :else
            (let [source-plan (planning/plan source profile overrides)]
              (if (not= (record-get [:ref :linux.static.plan/result] source-plan :error) :ok)
                (fail (record-get [:ref :linux.static.plan/result] source-plan :error) (record-get [:ref :linux.static.plan/result] source-plan :data))
                (package-planned source (record-get [:ref :linux.static.plan/result] source-plan :value)
                  target (bytes-of code) (i64-of offset))))))))))
