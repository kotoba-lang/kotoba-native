      (meta/value-vector-conj (meta/value-keyword :kgraph))
      (meta/value-vector-conj (meta/value-i64 98304))))
      (meta/value-vector-conj (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-keyword :vectors))
      (meta/value-vector-conj (meta/value-i64 (* 16 (i64-of table))))))
      (meta/value-vector-conj (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-keyword :vector-items))
      (meta/value-vector-conj (meta/value-i64 (* 8 (i64-of items))))))
      (meta/value-vector-conj (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-keyword :pool))
      (meta/value-vector-conj bytes)))))
                regions (if (good? base-regions) (append-region (value base-regions) :arena-marks 8192) base-regions)]
