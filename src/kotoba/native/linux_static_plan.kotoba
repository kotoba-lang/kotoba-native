;; Canonical planning boundary for the complete Linux-static packager.
;; Reference: linux_static.cljk, owning main 535ca0a3.
;; Source candidate only: no hosted numeric conversion or verifier callback.
(ns kotoba.native.linux-static-plan
  {:kotoba/export [targets implemented-slots slot-names plan image-layout]}
  (:require [kotoba.artifact.data :as meta]
            [kotoba.artifact.form-seal :as artifact]
            [kotoba.native.linux-static-sha256 :as sha256]
            [kotoba.native.linux-static-vectors :as vectors])
  (:schemas {:linux.static.plan/result
             [:record :linux.static.plan/result
              [[:value [:ref :form/r]] [:error :keyword] [:data [:ref :form/r]]]]}))

(defn- ok [value [:ref :form/r]] [:ref :linux.static.plan/result]
  (record-new [:ref :linux.static.plan/result] value :ok (meta/value-null)))

(defn- fail [error :keyword data [:ref :form/r]] [:ref :linux.static.plan/result]
  (record-new [:ref :linux.static.plan/result] (meta/value-null) error data))

(defn- value [r [:ref :linux.static.plan/result]] [:ref :form/r]
  (record-get [:ref :linux.static.plan/result] r :value))

(defn- good? [r [:ref :linux.static.plan/result]] :bool
  (= (record-get [:ref :linux.static.plan/result] r :error) :ok))

(defn- item [v [:ref :form/r] index :i64] [:ref :form/r]
  (option-value-of [:option [:ref :form/r]] (meta/value-vector-at v index) (meta/value-null)))

(defn- entry [m [:ref :form/r] index :i64] [:ref :form/r]
  (option-value-of [:option [:ref :form/r]] (meta/value-map-entry-at m index) (meta/value-null)))

(defn- lookup [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
  (if (not= (meta/value-kind m) :map) (meta/value-null)
    (loop [index 0]
      (if (>= index (meta/value-count m)) (meta/value-null)
        (let [pair (entry m index)]
          (if (meta/value-equal? (item pair 0) key) (item pair 1) (recur (+ index 1))))))))

(defn- has? [m [:ref :form/r] key [:ref :form/r]] :bool
  (if (not= (meta/value-kind m) :map) false
    (loop [index 0]
      (if (>= index (meta/value-count m)) false
        (if (meta/value-equal? (item (entry m index) 0) key) true (recur (+ index 1)))))))

(defn- get-key [m [:ref :form/r] key :keyword] [:ref :form/r] (lookup m (meta/value-keyword key)))
(defn- get2 [m [:ref :form/r] a :keyword b :keyword] [:ref :form/r] (get-key (get-key m a) b))
(defn- get3 [m [:ref :form/r] a :keyword b :keyword c :keyword] [:ref :form/r] (get-key (get2 m a b) c))
(defn- i64-of [d [:ref :form/r]] :i64 (option-value-of [:option :i64] (meta/value-i64-value d) 0))
(defn- string-of [d [:ref :form/r]] :string (option-value-of [:option :string] (meta/value-string-value d) ""))
(defn- key-of [d [:ref :form/r]] :keyword (option-value-of [:option :keyword] (meta/value-keyword-value d) :none))
(defn- bool-of [d [:ref :form/r]] :bool (option-value-of [:option :bool] (meta/value-bool-value d) false))
(defn- i64-document? [d [:ref :form/r]] :bool (= (meta/value-kind d) :i64))

(defn- truthy? [d [:ref :form/r]] :bool
  (and (not= (meta/value-kind d) :null) (not (and (= (meta/value-kind d) :bool) (not (bool-of d))))))

(defn- put [m [:ref :form/r] key [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
  (meta/value-merge m (-> (meta/value-map)
      (meta/value-map-insert key v))))

(defn- put-key [m [:ref :form/r] key :keyword v [:ref :form/r]] [:ref :form/r] (put m (meta/value-keyword key) v))

(defn- field [name :keyword] [:ref :form/r] (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :field) (meta/value-keyword name))))

(defn- sequence-vector [xs [:ref :form/r] reason :keyword] [:ref :linux.static.plan/result]
  (case (meta/value-kind xs)
    :vector (ok xs)
    :list (loop [index 0 out (meta/value-vector)]
            (if (>= index (meta/value-count xs)) (ok out)
              (recur (+ index 1)
                     (meta/value-vector-conj out
                       (option-value-of [:option [:ref :form/r]] (meta/value-list-at xs index) (meta/value-null))))))
    :set (ok (meta/value-as-vector xs))
    (fail reason xs)))

(defn- contains-value? [xs [:ref :form/r] x [:ref :form/r]] :bool
  (loop [index 0]
    (if (>= index (meta/value-count xs)) false
      (if (meta/value-equal? (item xs index) x) true (recur (+ index 1))))))

(defn- insert-wire [xs [:ref :form/r] wire :i64] [:ref :form/r]
  (loop [index 0 inserted false out (meta/value-vector)]
    (if (>= index (meta/value-count xs))
      (if inserted out (meta/value-vector-conj out (meta/value-i64 wire)))
      (let [current (i64-of (item xs index))]
        (cond
          (= current wire) xs
          (and (not inserted) (< wire current))
          (recur index true (meta/value-vector-conj out (meta/value-i64 wire)))
          :else (recur (+ index 1) inserted (meta/value-vector-conj out (item xs index))))))))

(defn- wire-vector [xs [:ref :form/r] reason :keyword] [:ref :linux.static.plan/result]
  (let [parsed (sequence-vector xs reason)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (meta/value-vector)]
        (if (>= index (meta/value-count (value parsed))) (ok out)
          (let [wire (item (value parsed) index)]
            (cond
              (not (i64-document? wire)) (fail reason wire)
              (or (< (i64-of wire) 0) (> (i64-of wire) 255)) (fail :capability-wire-range wire)
              :else (recur (+ index 1) (insert-wire out (i64-of wire))))))))))

(defn- effect-ids [effects [:ref :form/r]] [:ref :linux.static.plan/result]
  (let [parsed (sequence-vector (if (= (meta/value-kind effects) :null) (meta/value-vector) effects)
                                :effect-not-capability)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (meta/value-vector)]
        (if (>= index (meta/value-count (value parsed))) (ok out)
          (let [effect (item (value parsed) index)]
            (cond
              (and (= (meta/value-kind effect) :keyword)
                   (or (= (key-of effect) :state) (= (key-of effect) :abort)))
              (recur (+ index 1) out)
              (not (and (= (meta/value-kind effect) :vector) (= (meta/value-count effect) 2)
                        (= (meta/value-kind (item effect 0)) :keyword) (= (key-of (item effect 0)) :cap/call)
                        (i64-document? (item effect 1))))
              (fail :effect-not-capability effect)
              (or (< (i64-of (item effect 1)) 0) (> (i64-of (item effect 1)) 255))
              (fail :capability-wire-range effect)
              :else (recur (+ index 1) (insert-wire out (i64-of (item effect 1)))))))))))

(defn- canonical-scope? [path :string] :bool
  (let [bytes (string-to-utf8 path) n (bytes-count bytes)]
    (if (or (< n 1) (>= n 4096) (not= (bytes-at bytes 0) 47)
            (and (> n 1) (= (bytes-at bytes (- n 1)) 47))) false
      (if (= n 1) true
        (loop [index 1 start 1]
          (if (or (= index n) (= (bytes-at bytes index) 47))
            (let [length (- index start)]
              (if (or (= length 0)
                      (and (= length 1) (= (bytes-at bytes start) 46))
                      (and (= length 2) (= (bytes-at bytes start) 46) (= (bytes-at bytes (+ start 1)) 46))) false
                (if (= index n) true (recur (+ index 1) (+ index 1)))))
            (if (= (bytes-at bytes index) 0) false (recur (+ index 1) start))))))))

(defn- basename [path :string] :string
  (let [bytes (string-to-utf8 path) n (bytes-count bytes)]
    (loop [index 0 start 0]
      (if (>= index n) (string-substring path start n)
        (recur (+ index 1) (if (= (bytes-at bytes index) 47) (+ index 1) start))))))

(defn- env-name? [name :string] :bool
  (let [bytes (string-to-utf8 name) n (bytes-count bytes)]
    (if (or (< n 1) (>= n 256)) false
      (loop [index 0]
        (if (>= index n) true
          (if (or (= (bytes-at bytes index) 0) (= (bytes-at bytes index) 61)) false (recur (+ index 1))))))))

(defn- spawn-programs [programs [:ref :form/r] lookup? :bool] [:ref :linux.static.plan/result]
  (if (or (not= (meta/value-kind programs) :vector) (> (meta/value-count programs) 16))
    (fail :spawn-programs-malformed programs)
    (loop [index 0 seen (meta/value-vector) names (meta/value-vector)]
      (if (>= index (meta/value-count programs)) (ok programs)
        (let [program (item programs index)]
          (cond
            (or (not= (meta/value-kind program) :string) (not (canonical-scope? (string-of program)))
                (string=? (string-of program) "/") (contains-value? seen program))
            (fail :spawn-programs-malformed program)
            (and lookup? (contains-value? names (meta/value-string (basename (string-of program)))))
            (fail :spawn-lookup-ambiguous program)
            :else (recur (+ index 1) (meta/value-vector-conj seen program)
                         (meta/value-vector-conj names (meta/value-string (basename (string-of program)))))))))))

(defn- spawn-env [env [:ref :form/r]] [:ref :linux.static.plan/result]
  (if (or (not= (meta/value-kind env) :vector) (> (meta/value-count env) 16))
    (fail :spawn-env-malformed env)
    (loop [index 0]
      (if (>= index (meta/value-count env)) (ok env)
        (let [name (item env index)]
          (if (and (= (meta/value-kind name) :string) (env-name? (string-of name)))
            (recur (+ index 1)) (fail :spawn-env-malformed name)))))))

(defn- spawn-grant [spawn [:ref :form/r] grant [:ref :form/r]] [:ref :linux.static.plan/result]
  (if (not (truthy? spawn))
    (ok (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :programs) (meta/value-vector))
      (meta/value-map-insert (meta/value-keyword :path-lookup) (meta/value-bool false))
      (meta/value-map-insert (meta/value-keyword :env) (meta/value-vector))))
    (cond
      (not (contains-value? grant (meta/value-i64 20))) (fail :spawn-without-capability spawn)
      (not= (meta/value-kind spawn) :map) (fail :spawn-programs-malformed spawn)
      :else
      (let [programs0 (get-key spawn :programs) env0 (get-key spawn :env)
            lookup (get-key spawn :path-lookup)
            programs (if (truthy? programs0) programs0 (meta/value-vector))
            env (if (truthy? env0) env0 (meta/value-vector))]
        (if (not (or (= (meta/value-kind lookup) :null) (= (meta/value-kind lookup) :bool)))
          (fail :spawn-path-lookup-malformed lookup)
          (let [pr (spawn-programs programs (bool-of lookup)) er (spawn-env env)]
            (cond
              (not (good? pr)) pr
              (not (good? er)) er
              :else (ok (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :programs) (value pr))
      (meta/value-map-insert (meta/value-keyword :path-lookup) (meta/value-bool (bool-of lookup)))
      (meta/value-map-insert (meta/value-keyword :env) (value er)))))))))))

(defn targets [] [:ref :form/r]
  (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :x86_64-linux-static-kotoba-v1) (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :isa) (meta/value-keyword :x86_64))
      (meta/value-map-insert (meta/value-keyword :machine) (meta/value-keyword :x86-64))
      (meta/value-map-insert (meta/value-keyword :context-register) (meta/value-keyword :r9))))
      (meta/value-map-insert (meta/value-keyword :aarch64-linux-static-kotoba-v1) (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :isa) (meta/value-keyword :aarch64))
      (meta/value-map-insert (meta/value-keyword :machine) (meta/value-keyword :aarch64))
      (meta/value-map-insert (meta/value-keyword :context-register) (meta/value-keyword :x7))))))

(defn implemented-slots [] [:ref :form/r]
  (-> (meta/value-set)
      (meta/value-set-conj (meta/value-keyword :arena-enter))
      (meta/value-set-conj (meta/value-keyword :arena-leave))
      (meta/value-set-conj (meta/value-keyword :pair-new))
      (meta/value-set-conj (meta/value-keyword :pair-first))
      (meta/value-set-conj (meta/value-keyword :pair-second))
      (meta/value-set-conj (meta/value-keyword :kgraph-assert))
      (meta/value-set-conj (meta/value-keyword :kgraph-get))
      (meta/value-set-conj (meta/value-keyword :string-equal))
      (meta/value-set-conj (meta/value-keyword :string-concat))
      (meta/value-set-conj (meta/value-keyword :string-substring))
      (meta/value-set-conj (meta/value-keyword :string-index-of))
      (meta/value-set-conj (meta/value-keyword :string-code-point-at))
      (meta/value-set-conj (meta/value-keyword :string-compare))
      (meta/value-set-conj (meta/value-keyword :vector-new-empty))
      (meta/value-set-conj (meta/value-keyword :vector-conj))
      (meta/value-set-conj (meta/value-keyword :vector-count))
      (meta/value-set-conj (meta/value-keyword :vector-at))
      (meta/value-set-conj (meta/value-keyword :vector-assoc))
      (meta/value-set-conj (meta/value-keyword :vector-alloc))
      (meta/value-set-conj (meta/value-keyword :vector-assoc-in-place))
      (meta/value-set-conj (meta/value-keyword :vector-drop))
      (meta/value-set-conj (meta/value-keyword :bytes-from-vector))
      (meta/value-set-conj (meta/value-keyword :bytes-slice))
      (meta/value-set-conj (meta/value-keyword :bytes-concat))
      (meta/value-set-conj (meta/value-keyword :string-from-utf8))
      (meta/value-set-conj (meta/value-keyword :typed-cap-call))))

(defn- normalized-code [code [:ref :form/r]] [:ref :linux.static.plan/result]
  ;; A decision component is a bounded byte node, not one document-vector
  ;; member per byte. That vector would exceed the document collection bound.
  (if (= (meta/value-kind code) :bytes)
    (if (option-some?-of [:option :bytes] (meta/value-bytes-value code))
      (ok code) (fail :handler-code code))
    (let [parsed (sequence-vector code :handler-code)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (vector-alloc (meta/value-count (value parsed)))]
        (if (>= index (meta/value-count (value parsed)))
          (ok (meta/value-bytes (bytes-from-vector-i64 out)))
          (let [byte (item (value parsed) index)]
            (if (not (i64-document? byte)) (fail :handler-code byte)
              (recur (+ index 1) (vector-assoc! out index (bit-and (i64-of byte) 255)))))))))))

(defn- code-size [code [:ref :form/r]] :i64
  (bytes-count (option-value-of [:option :bytes] (meta/value-bytes-value code) (bytes-empty))))

(defn- handler-code [source [:ref :form/r] isa :keyword names [:ref :form/r]] [:ref :linux.static.plan/result]
  (cond
    (or (not= (meta/value-kind source) :map) (not (artifact/valid-seal? source)))
    (fail :handler-unsealed (get-key source :sha256))
    (not (meta/value-equal? (get-key source :lowering)
                          (meta/value-keyword (if (= isa :x86_64) :runtime-sysv-v1 :runtime-aapcs64-v1))))
    (fail :handler-isa (get-key source :lowering))
    :else
    (let [code (normalized-code (get-key source :code)) exports (get-key source :exports)]
      (if (not (good? code)) code
        (loop [index 0 offsets (meta/value-map)]
          (if (>= index (meta/value-count names))
            (ok (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :code) (value code))
      (meta/value-map-insert (meta/value-keyword :offsets) offsets)))
            (let [name (item names index) export (lookup exports name) offset (get-key export :offset)]
              (if (or (not= (meta/value-kind export) :map) (not (i64-document? offset))
                      (< (i64-of offset) 0) (>= (i64-of offset) (code-size (value code))))
                (fail :handler-export name)
                (recur (+ index 1) (put offsets name offset))))))))))

(defn- handler-pair [overrides [:ref :form/r] isa :keyword] [:ref :linux.static.plan/result]
  (let [handlers (get-key overrides :handlers)
        decisions (get-key handlers :decisions) service (get-key handlers :handlers)]
    (if (or (not (truthy? decisions)) (not (truthy? service))) (fail :handlers-missing handlers)
      (let [dr (handler-code decisions isa
                 (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-symbol "cap-admitted"))
      (meta/value-vector-conj (meta/value-symbol "decide"))))]
        (if (not (good? dr)) dr
          (let [hr (handler-code service isa (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-symbol "decide"))))]
            (if (not (good? hr)) hr
              (ok (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :decisions) (value dr))
      (meta/value-map-insert (meta/value-keyword :handlers) (value hr)))))))))))

(defn- grant-subset? [grant [:ref :form/r] effects [:ref :form/r]] :bool
  (loop [index 0]
    (if (>= index (meta/value-count grant)) true
      (if (contains-value? effects (item grant index)) (recur (+ index 1)) false))))

(defn- unhandled [effects [:ref :form/r] handled [:ref :form/r] named [:ref :form/r]] [:ref :form/r]
  (loop [index 0 out (meta/value-vector)]
    (if (>= index (meta/value-count effects)) out
      (let [wire (item effects index)]
        (recur (+ index 1)
               (if (has? handled wire) out
                 (meta/value-vector-conj out (-> (meta/value-vector)
      (meta/value-vector-conj wire)
      (meta/value-vector-conj (lookup named wire))))))))))

(defn- capability-plan [source [:ref :form/r] profile [:ref :form/r] overrides [:ref :form/r]] [:ref :linux.static.plan/result]
  (let [effects (effect-ids (get-key source :effects))
        target (lookup (targets) (get-key source :target))
        raw-grant (get-key overrides :grant)
        scope (get-key overrides :fs-scope)]
    (if (not (good? effects)) effects
      (let [missing (unhandled (value effects)
                      (get3 profile :static-elf :capability-handlers :value)
                      (get3 profile :static-elf :refused-capabilities :value))
            grant (wire-vector (if (truthy? raw-grant) raw-grant (value effects)) :grant-malformed)]
        (cond
          (> (meta/value-count missing) 0) (fail :capability-without-handler missing)
          (not (good? grant)) grant
          (not (grant-subset? (value grant) (value effects))) (fail :grant-widens-effects (value grant))
          (and (truthy? scope) (or (not= (meta/value-kind scope) :string) (not (canonical-scope? (string-of scope)))))
          (fail :fs-scope-not-canonical scope)
          (and (> (meta/value-count (value effects)) 0) (= (meta/value-kind target) :null))
          (fail :not-linux-static (get-key source :target))
          :else
          (let [spawn (spawn-grant (get-key overrides :spawn) (value grant))]
            (if (not (good? spawn)) spawn
              (let [base (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :effect-ids) (value effects))
      (meta/value-map-insert (meta/value-keyword :grant) (value grant))
      (meta/value-map-insert (meta/value-keyword :fs-scope) scope)
      (meta/value-map-insert (meta/value-keyword :spawn) (value spawn)))]
                (if (= (meta/value-count (value effects)) 0) (ok base)
                  (let [handlers (handler-pair overrides (key-of (get-key target :isa)))]
                    (if (not (good? handlers)) handlers
                      (ok (put-key base :handler-code (value handlers))))))))))))))

(defn- data-word? [name :keyword] :bool
  (case name
    :fuel-offset true :allow-bitmap-offset true :pair-used-pointer-offset true
    :pairs-base-offset true :pair-validated-base-offset true
    :vector-used-pointer-offset true :vectors-base-offset true :vector-items-base-offset true false))

;; The reference sorted-map compares keyword names as UTF-16, on both hosts.
;; Canonical strings use UTF-8 bytes; compare the corresponding code units.
(defn- utf16-units [name :string] :vector-i64
  (let [bytes (string-to-utf8 name) n (bytes-count bytes)]
    (loop [index 0 out (vector-alloc 0)]
      (if (>= index n) out
        (let [a (bytes-at bytes index)
              width (if (< a 128) 1 (if (< a 224) 2 (if (< a 240) 3 4)))
              point
              (if (= width 1) a
                (if (= width 2)
                  (+ (* (bit-and a 31) 64) (bit-and (bytes-at bytes (+ index 1)) 63))
                  (if (= width 3)
                    (+ (* (bit-and a 15) 4096) (* (bit-and (bytes-at bytes (+ index 1)) 63) 64)
                       (bit-and (bytes-at bytes (+ index 2)) 63))
                    (+ (* (bit-and a 7) 262144) (* (bit-and (bytes-at bytes (+ index 1)) 63) 4096)
                       (* (bit-and (bytes-at bytes (+ index 2)) 63) 64) (bit-and (bytes-at bytes (+ index 3)) 63)))))
              next (if (< point 65536) (vector-conj out point)
                     (let [rest (- point 65536)]
                       (vector-conj (vector-conj out (+ 55296 (quot rest 1024))) (+ 56320 (bit-and rest 1023)))))]
          (recur (+ index width) next))))))

(defn- compare-names [a :string b :string] :i64
  (let [x (utf16-units a) y (utf16-units b)
        xn (vector-count x) yn (vector-count y)]
    (loop [index 0]
      (if (or (>= index xn) (>= index yn)) (- xn yn)
        (let [difference (- (vector-at x index) (vector-at y index))]
          (if (not= difference 0) difference (recur (+ index 1))))))))

(defn- sort-keyed-map [m [:ref :form/r]] [:ref :form/r]
  (loop [remaining m out (meta/value-map)]
    (if (= (meta/value-count remaining) 0) out
      (let [best (loop [index 1 selected 0]
                   (if (>= index (meta/value-count remaining)) selected
                     (let [a (keyword-name (key-of (item (entry remaining index) 0)))
                           b (keyword-name (key-of (item (entry remaining selected) 0)))]
                       (recur (+ index 1) (if (< (compare-names a b) 0) index selected)))))
            pair (entry remaining best) key (item pair 0)
            rest (loop [index 0 result (meta/value-map)]
                   (if (>= index (meta/value-count remaining)) result
                     (let [current (entry remaining index)]
                       (recur (+ index 1)
                              (if (= index best) result (put result (item current 0) (item current 1)))))))]
        (recur rest (put out key (item pair 1)))))))

(defn slot-names [context [:ref :form/r]] [:ref :linux.static.plan/result]
  (if (not= (meta/value-kind context) :map) (fail :context-abi-shape context)
    (loop [index 0 out (meta/value-map)]
      (if (>= index (meta/value-count context)) (ok (sort-keyed-map out))
        (let [pair (entry context index) key (item pair 0) offset (item pair 1)]
          (if (not= (meta/value-kind key) :keyword) (fail :context-abi-key key)
            (let [name (keyword-name (key-of key)) length (string-length name)]
              (if (and (>= length 7) (string=? (string-substring name (- length 7) length) "-offset")
                       (not (data-word? (key-of key))))
                (if (= length 7) (fail :context-abi-key key)
                  (if (or (not (i64-document? offset)) (< (i64-of offset) 0)) (fail :context-abi-offset pair)
                    (recur (+ index 1)
                           (put out (meta/value-keyword (keyword-from-string (string-substring name 0 (- length 7)))) offset))))
                (recur (+ index 1) out)))))))))

(defn- admitted-slots [raw [:ref :form/r]] [:ref :linux.static.plan/result]
  (let [parsed (sequence-vector raw :native-profile-incomplete)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (meta/value-vector)]
        (if (>= index (meta/value-count (value parsed))) (ok out)
          (let [slot (item (value parsed) index)]
            (cond
              (not= (meta/value-kind slot) :keyword) (fail :native-profile-incomplete (field :admitted-slots))
              (not (meta/value-set-contains? (implemented-slots) slot)) (fail :admitted-slot-unimplemented slot)
              :else (recur (+ index 1) (if (contains-value? out slot) out (meta/value-vector-conj out slot))))))))))

(defn- exit-codes [exits [:ref :form/r] traps [:ref :form/r] handlers? :bool] [:ref :linux.static.plan/result]
  (let [required (-> (meta/value-vector)
      (meta/value-vector-conj (meta/value-keyword :ok))
      (meta/value-vector-conj (meta/value-keyword :trap/signal))
      (meta/value-vector-conj (meta/value-keyword :budget/fuel))
      (meta/value-vector-conj (meta/value-keyword :budget/cells))
      (meta/value-vector-conj (meta/value-keyword :budget/bytes))
      (meta/value-vector-conj (get-key traps :slot))
      (meta/value-vector-conj (get-key traps :fuel))
      (meta/value-vector-conj (get-key traps :cells))
      (meta/value-vector-conj (get-key traps :bytes)))
        all (if handlers? (meta/value-vector-conj required (meta/value-keyword :capability/refused)) required)]
    (loop [index 0]
