      (meta/value-vector-conj (value index)))))))))))

(defn- hash-layout [current [:ref :linux.static.plan/result] source-plan [:ref :form/r]]
  [:ref :linux.static.plan/result]
  (if (not (good? current)) current
    (let [raw (get-key source-plan :grant)
          grant (wire-vector (if (= (meta/value-kind raw) :null) (meta/value-vector) raw) :grant-malformed)]
