        (let [outcome (item all index)]
          (if (not (i64-document? (lookup exits outcome))) (fail :exit-code-missing outcome)
            (recur (+ index 1))))))))

(defn- vector-slots? [admitted [:ref :form/r]] :bool
  (loop [index 0]
    (if (>= index (meta/value-count admitted)) false
      (if (meta/value-set-contains? (vectors/supported-slots) (item admitted index)) true (recur (+ index 1))))))

(defn- bytes-slots? [admitted [:ref :form/r]] :bool
  (loop [index 0]
    (if (>= index (meta/value-count admitted)) false
      (if (meta/value-set-contains? (vectors/supported-byte-slots) (item admitted index)) true (recur (+ index 1))))))
(defn- byte-value-traps [static [:ref :form/r] bytes? :bool] [:ref :linux.static.plan/result]
  (if (not bytes?) (ok (meta/value-vector))
    (let [names (get2 static :bytes-value-traps :value)]
      (if (or (not= (meta/value-kind names) :vector) (not= (meta/value-count names) 11))
        (fail :native-profile-incomplete (field :bytes-value-traps))
