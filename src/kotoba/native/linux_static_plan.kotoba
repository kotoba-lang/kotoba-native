          (if (= i 11) (ok names)
            (if (= (meta/value-kind (item names i)) :keyword) (recur (+ i 1))
              (fail :native-profile-incomplete (field :bytes-value-traps)))))))))

(defn- budgets [profile [:ref :form/r] overrides [:ref :form/r] vectors? :bool bytes? :bool] [:ref :linux.static.plan/result]
  (let [raw-cells (get-key overrides :cells) raw-bytes (get-key overrides :bytes)
        cells (if (truthy? raw-cells) raw-cells (get3 profile :cells :default :value))
        cells-max (get3 profile :cells :pair-arena-max :value)
        bytes (if (truthy? raw-bytes) raw-bytes (get3 profile :bytes :default :value))
        bytes-max (get3 profile :bytes :max :value)
        raw-vectors (get-key overrides :vectors) raw-items (get-key overrides :vector-items)
        table (if (truthy? raw-vectors) raw-vectors (get3 profile :cells :vectors :value))
        table-max (get3 profile :cells :vectors :max)
        items (if (truthy? raw-items) raw-items (get3 profile :cells :vector-items :value))
        items-max (get3 profile :cells :vector-items :max)
        limit (get3 profile :cells :vector-items :per-vector-max)
        byte-limit (get2 profile :bytes :value-max) string-limit (get2 profile :bytes :string-value-max)]
    (cond
      (not (i64-document? cells-max)) (fail :native-profile-incomplete (field :pair-arena-max))
      (not (i64-document? bytes-max)) (fail :native-profile-incomplete (field :bytes-max))
      (or (not (i64-document? cells)) (< (i64-of cells) 1) (> (i64-of cells) (i64-of cells-max)))
      (fail :cells-outside-profile cells)
      (or (not (i64-document? bytes)) (< (i64-of bytes) 1) (> (i64-of bytes) (i64-of bytes-max)))
      (fail :bytes-outside-profile bytes)
      (and vectors? (or (not (i64-document? table-max)) (not (i64-document? items-max))
                       (not (i64-document? limit)) (< (i64-of table-max) 1)
                       (< (i64-of items-max) 1) (< (i64-of limit) 1)))
      (fail :native-profile-incomplete (field :vector-bounds))
      (and vectors? (or (not (i64-document? table)) (< (i64-of table) 1) (> (i64-of table) (i64-of table-max))))
      (fail :vectors-outside-profile table)
      (and vectors? (or (not (i64-document? items)) (< (i64-of items) 1) (> (i64-of items) (i64-of items-max))))
      (fail :vector-items-outside-profile items)
      (and (not vectors?) (or (truthy? raw-vectors) (truthy? raw-items)))
      (fail :vector-slots-not-admitted (field :vectors))
      (and bytes? (or (not (i64-document? byte-limit)) (< (i64-of byte-limit) 1) (> (i64-of byte-limit) 65536)
                     (not (i64-document? string-limit)) (< (i64-of string-limit) 1) (> (i64-of string-limit) 65536)))
      (fail :native-profile-incomplete (field :byte-value-bounds))
      :else (ok (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :cells) cells)
      (meta/value-map-insert (meta/value-keyword :bytes) bytes)
      (meta/value-map-insert (meta/value-keyword :vectors) (if vectors? table (meta/value-i64 0)))
      (meta/value-map-insert (meta/value-keyword :vector-items) (if vectors? items (meta/value-i64 0)))
      (meta/value-map-insert (meta/value-keyword :vector-item-limit) (if vectors? limit (meta/value-i64 0)))
      (meta/value-map-insert (meta/value-keyword :byte-value-limit) (if bytes? byte-limit (meta/value-i64 0)))
      (meta/value-map-insert (meta/value-keyword :string-value-limit) (if bytes? string-limit (meta/value-i64 0))))))))

(defn- slot-plan [names [:ref :form/r] admitted [:ref :form/r] handlers? :bool] [:ref :form/r]
  (loop [index 0 out (meta/value-map)]
    (if (>= index (meta/value-count names)) out
      (let [pair (entry names index) slot (item pair 0)]
        (recur (+ index 1)
               (put out slot
                    (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :offset) (item pair 1))
      (meta/value-map-insert (meta/value-keyword :admitted?) (meta/value-bool (and (contains-value? admitted slot)
                                     (or (not= (key-of slot) :typed-cap-call) handlers?)))))))))))

(defn plan [source [:ref :form/r] profile [:ref :form/r] overrides [:ref :form/r]] [:ref :linux.static.plan/result]
  (let [static (get-key profile :static-elf)
        context (get-key source :context-abi)
        fuel (get2 source :fuel-abi :initial)
        traps (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :fuel) (get2 profile :fuel :trap))
      (meta/value-map-insert (meta/value-keyword :cells) (get2 profile :cells :trap))
      (meta/value-map-insert (meta/value-keyword :bytes) (get2 profile :bytes :trap))
      (meta/value-map-insert (meta/value-keyword :slot) (get-key static :unimplemented-slot-trap)))]
    (cond
      (not= (meta/value-kind static) :map) (fail :native-profile-incomplete (field :static-elf))
      (or (not= (meta/value-kind (get-key traps :fuel)) :keyword)
          (not= (meta/value-kind (get-key traps :cells)) :keyword)
          (not= (meta/value-kind (get-key traps :bytes)) :keyword)
          (not= (meta/value-kind (get-key traps :slot)) :keyword))
      (fail :native-profile-incomplete (field :trap-names))
      (or (not (i64-document? (get-key context :version))) (not= (i64-of (get-key context :version)) 11))
      (fail :context-abi-version (get-key context :version))
      (not (i64-document? fuel)) (fail :native-profile-incomplete (field :initial-fuel))
      :else
      (let [names (slot-names context)
            admitted (admitted-slots (get2 static :admitted-slots :value))
            byte-slots (and (good? admitted) (bytes-slots? (value admitted)))
            values (byte-value-traps static byte-slots)
            limits (budgets profile overrides (and (good? admitted) (vector-slots? (value admitted))) byte-slots)]
        (cond
          (not (good? limits)) limits
          (not (good? names)) names
          (not (good? admitted)) admitted
          (not (good? values)) values
          :else
          (let [caps (capability-plan source profile overrides)]
            (if (not (good? caps)) caps
              (let [handlers? (> (meta/value-count (get-key (value caps) :effect-ids)) 0)
                    exits (exit-codes (get2 static :exit-codes :value) traps handlers?)]
                (if (not (good? exits)) exits
                  (ok (meta/value-merge (meta/value-merge (value caps) (value limits))
                         (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword :metered?) (meta/value-bool (not (meta/value-equal? (get2 source :limits :fuel-metering) (meta/value-keyword :off)))))
      (meta/value-map-insert (meta/value-keyword :handlers?) (meta/value-bool handlers?))
      (meta/value-map-insert (meta/value-keyword :fuel) fuel)
      (meta/value-map-insert (meta/value-keyword :trap-names) traps)
      (meta/value-map-insert (meta/value-keyword :exit-codes) (value exits))
      (meta/value-map-insert (meta/value-keyword :bytes-value-traps) (value values))
      (meta/value-map-insert (meta/value-keyword :slots) (slot-plan (value names) (value admitted) handlers?))
      (meta/value-map-insert (meta/value-keyword :context-abi) context)))))))))))))

(defn- checked-align [n :i64 alignment :i64] [:ref :linux.static.plan/result]
  (if (or (< n 0) (< alignment 1)) (fail :layout-overflow (meta/value-i64 n))
    (let [remainder (- n (* (quot n alignment) alignment))
          extra (if (= remainder 0) 0 (- alignment remainder))]
      (if (> extra (- 9223372036854775807 n)) (fail :layout-overflow (meta/value-i64 n))
        (ok (meta/value-i64 (+ n extra)))))))

(defn- append-region [layout [:ref :form/r] name :keyword size :i64] [:ref :linux.static.plan/result]
  (let [end (i64-of (get-key layout :end))]
    (if (or (< size 0) (> size (- 9223372036854775807 end)))
      (fail :layout-overflow (field name))
      (ok (put-key (put-key layout name (meta/value-i64 end)) :end (meta/value-i64 (+ end size)))))))

(defn- append-regions [initial [:ref :linux.static.plan/result] regions [:ref :form/r]] [:ref :linux.static.plan/result]
