      (meta/value-map-insert (meta/value-keyword :data-offset) (meta/value-i64 offset))
      (meta/value-map-insert (meta/value-keyword :data) (meta/value-i64 (+ 4194304 offset)))
      (meta/value-map-insert (meta/value-keyword :end) (meta/value-i64 (+ 4198400 offset)))))))))))

