;; Whole Linux-static startup, signal/trap paths and admitted slot composition.
;; Source candidate. Sealed planning/profile decisions remain authoritative.
(ns kotoba.native.linux-static-prelude
  {:kotoba/export [routine]}
  (:require [kotoba.artifact.data :as meta]
            [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-strings :as strings]
            [kotoba.native.linux-static-vectors :as vectors]
            [kotoba.native.linux-static-graph :as graph]
            [kotoba.native.linux-static-arena :as arena]
            [kotoba.native.linux-static-capability :as capability]
            [kotoba.native.linux-static-output :as owned-output]
            [kotoba.native.linux-static-io :as io])
  (:schemas
   {:linux.static.prelude/config
    [:record :linux.static.prelude/config
     [[:isa :keyword] [:data :i64] [:fuel :i64] [:plan [:ref :form/r]]]]
    :linux.static.prelude/slots
    [:record :linux.static.prelude/slots
     [[:code [:list [:ref :linux.static/instruction]]] [:bindings [:ref :form/r]] [:error :keyword]]]
    :linux.static.prelude/result
    [:record :linux.static.prelude/result
     [[:code [:list [:ref :linux.static/instruction]]] [:bindings [:ref :form/r]]
      [:externals [:ref :form/r]] [:error :keyword]]]}))

(defn- empty-code [] [:list [:ref :linux.static/instruction]]
  (typed-list-new [:list [:ref :linux.static/instruction]]))
(defn- append [out [:list [:ref :linux.static/instruction]] op :keyword aux :keyword
               d :keyword s :keyword b :keyword i :keyword n :i64 target :string]
  [:list [:ref :linux.static/instruction]]
  (typed-list-conj [:list [:ref :linux.static/instruction]] out
    (asm/instruction op aux d s b i n target (vector-alloc 0))))
(defn- join [out [:list [:ref :linux.static/instruction]] code [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (loop [index 0 current out]
    (if (>= index (vector-count code)) current
      (recur (+ index 1) (typed-list-conj [:list [:ref :linux.static/instruction]] current
                            (typed-list-nth [:list [:ref :linux.static/instruction]] code index))))))
(defn- tag [prefix :string suffix :string] :string
  (string-concat (string-concat "ls.prelude/" prefix) (string-concat "-" suffix)))
(defn- mark [out [:list [:ref :linux.static/instruction]] label :string]
  [:list [:ref :linux.static/instruction]] (append out :label :none :none :none :none :none 0 label))
(defn- li [out [:list [:ref :linux.static/instruction]] d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :li :none d :none :none :none n ""))
(defn- la [out [:list [:ref :linux.static/instruction]] d :keyword label :string]
  [:list [:ref :linux.static/instruction]] (append out :la :none d :none :none :none 0 label))
(defn- mov [out [:list [:ref :linux.static/instruction]] d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :mov :none d s :none :none 0 ""))
(defn- mem [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base :none n ""))
(defn- byte-op [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword i :keyword]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base i 0 ""))
(defn- alu [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :alu op d s :none :none 0 ""))
(defn- imm [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :alui op d :none :none :none n ""))
(defn- branch [out [:list [:ref :linux.static/instruction]] condition :keyword label :string]
  [:list [:ref :linux.static/instruction]]
  (append out (if (= condition :always) :b :bcc) condition :none :none :none :none 0 label))
(defn- lookup [m [:ref :form/r] key :keyword] [:ref :form/r]
  (if (not= (meta/value-kind m) :map) (meta/value-null)
    (loop [index 0]
      (if (>= index (meta/value-count m)) (meta/value-null)
        (let [pair (option-value-of [:option [:ref :form/r]] (meta/value-map-entry-at m index) (meta/value-null))
              k (option-value-of [:option [:ref :form/r]] (meta/value-vector-at pair 0) (meta/value-null))]
          (if (meta/value-equal? k (meta/value-keyword key))
            (option-value-of [:option [:ref :form/r]] (meta/value-vector-at pair 1) (meta/value-null)) (recur (+ index 1))))))))
(defn- item [v [:ref :form/r] index :i64] [:ref :form/r]
  (option-value-of [:option [:ref :form/r]] (meta/value-vector-at v index) (meta/value-null)))
(defn- entry [m [:ref :form/r] index :i64] [:ref :form/r]
  (option-value-of [:option [:ref :form/r]] (meta/value-map-entry-at m index) (meta/value-null)))
(defn- i64-of [d [:ref :form/r]] :i64 (option-value-of [:option :i64] (meta/value-i64-value d) -1))
(defn- key-of [d [:ref :form/r]] :keyword (option-value-of [:option :keyword] (meta/value-keyword-value d) :none))
(defn- true? [d [:ref :form/r]] :bool (meta/value-equal? d (meta/value-bool true)))
(defn- exit-code [cfg [:ref :linux.static.prelude/config] kind :keyword] :i64
  (i64-of (lookup (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :exit-codes) kind)))
(defn- trap-name [cfg [:ref :linux.static.prelude/config] kind :keyword] :keyword
  (key-of (lookup (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :trap-names) kind)))
(defn- budget-message [cfg [:ref :linux.static.prelude/config] kind :keyword arena :string] :string
  (string-concat "KEXE_TRAP {:kind :budget :reason "
    (string-concat (meta/value-edn-print (meta/value-keyword (trap-name cfg kind))) (string-concat arena "}\n"))))
(defn- slot-message [cfg [:ref :linux.static.prelude/config] slot :keyword] :string
  (string-concat "KEXE_TRAP {:kind :slot :reason "
    (string-concat (meta/value-edn-print (meta/value-keyword (trap-name cfg :slot)))
      (string-concat " :slot " (string-concat (meta/value-edn-print (meta/value-keyword slot)) "}\n")))))
(defn- signal-number [index :i64] :i64 (case index 0 4 1 5 2 7 3 8 4 11 -1))
(defn- signal-name [index :i64] :string
  (case index 0 "SIGILL" 1 "SIGTRAP" 2 "SIGBUS" 3 "SIGFPE" 4 "SIGSEGV" "unknown"))
(defn- signal-message [index :i64] :string
  (string-concat "KEXE_TRAP {:kind :signal :signal :" (string-concat (signal-name index) "}\n")))
(defn- byte-value-label [index :i64] :string
  (string-concat "ls.bytes/value-" (string-from-i64 index)))
(defn- byte-value-message [cfg [:ref :linux.static.prelude/config] index :i64] :string
  (let [names (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :bytes-value-traps)]
    (string-concat "KEXE_TRAP {:kind :value :reason "
      (string-concat (meta/value-edn-print (item names (- index 1))) "}\n"))))
(defn- data-bytes [out [:list [:ref :linux.static/instruction]] label :string text :string]
  [:list [:ref :linux.static/instruction]]
  (let [input (string-to-utf8 text)
        bytes (loop [index 0 data (vector-alloc 0)]
                (if (>= index (bytes-count input)) data
                  (recur (+ index 1) (vector-conj data (bytes-at input index)))))]
    (typed-list-conj [:list [:ref :linux.static/instruction]] (mark out label)
      (asm/instruction :bytes :none :none :none :none :none 0 "" bytes))))
(defn- named [out [:list [:ref :linux.static/instruction]] label :string message :string text :string code :i64]
  [:list [:ref :linux.static/instruction]]
  (-> out (mark label) (la :p1 message) (li :p2 (bytes-count (string-to-utf8 text)))
      (li :t5 code) (branch :always "ls/trap-exit")))
(defn- sys [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config] call :keyword
            a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand]
            c [:ref :linux.static.io/operand] d [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (io/syscall-fragment out (record-get [:ref :linux.static.prelude/config] cfg :isa) call a b c d (io/literal 0)))

(defn- startup [cfg [:ref :linux.static.prelude/config]] [:list [:ref :linux.static/instruction]]
  (let [data (record-get [:ref :linux.static.prelude/config] cfg :data)
        plan (record-get [:ref :linux.static.prelude/config] cfg :plan)
        captured (-> (empty-code) (mark "ls/start") (li :s0 data)
                     (append :ld-sp :none :t0 :none :none :none 0 "") (mem :st :t0 :s0 (io/state-offset :argc))
                     (append :lea-sp :none :t0 :none :none :none 8 "") (mem :st :t0 :s0 (io/state-offset :argv))
                     (li :t0 0) (mem :st :t0 :s0 (io/state-offset :vector-used))
                     (mem :st :t0 :s0 (io/state-offset :vector-item-used))
                     (li :t0 (i64-of (lookup plan :vectors))) (mem :st :t0 :s0 (io/state-offset :vector-capacity))
                     (li :t0 (i64-of (lookup plan :vector-items))) (mem :st :t0 :s0 (io/state-offset :vector-item-capacity))
                     (li :t0 (i64-of (lookup plan :vector-item-limit))) (mem :st :t0 :s0 (io/state-offset :vector-item-limit))
                     (li :t0 (i64-of (lookup plan :byte-value-limit))) (mem :st :t0 :s0 (io/state-offset :byte-value-limit))
                     (li :t0 (i64-of (lookup plan :string-value-limit))) (mem :st :t0 :s0 (io/state-offset :string-value-limit)))
        alternate (-> (sys captured cfg :sigaltstack (io/literal (+ data (io/state-offset :stack-t)))
                         (io/literal 0) (io/literal 0) (io/literal 0))
                      (imm :cmp :t0 0) (branch :ne "ls/bad"))]
    (loop [index 0 code alternate]
      (if (= index 5) code
        (recur (+ index 1)
          (-> (sys code cfg :rt-sigaction (io/literal (signal-number index))
                 (io/literal (+ data (io/state-offset :sigaction))) (io/literal 0) (io/literal 8))
              (imm :cmp :t0 0) (branch :ne "ls/bad")))))))

(defn- cleanup-message [] :string
  "KEXE_TRAP {:kind :cleanup :reason :output-cleanup-incomplete}\n")
(defn- cleanup-before-exit [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]
                           prefix :string fd :i64]
  [:list [:ref :linux.static/instruction]]
  (if (not (true? (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :handlers?))) out
    (let [saved (-> out (li :s0 (record-get [:ref :linux.static.prelude/config] cfg :data))
                    (mem :st :p1 :s0 (io/state-offset :out-message))
                    (mem :st :p2 :s0 (io/state-offset :out-message-length))
                    (mem :st :t5 :s0 (io/state-offset :out-exit))
                    (append :call :none :none :none :none :none 0 "ls.output/cleanup")
                    (mov :t0 :ret) (imm :cmp :t0 1) (branch :eq (tag prefix "cleanup-done")))
          failed (if (= fd 1)
                   (-> saved (li :t0 (exit-code cfg :capability/refused))
                       (mem :st :t0 :s0 (io/state-offset :out-exit))) saved)
          message (-> failed (la :p1 "ls.prelude/cleanup-message")
                      (li :p2 (bytes-count (string-to-utf8 (cleanup-message))))
                      (mark (tag prefix "cleanup-write")) (imm :cmp :p2 0) (branch :eq (tag prefix "cleanup-done")))
          wrote (sys message cfg :write (io/literal 2) (io/register :p1) (io/register :p2) (io/literal 0))]
      (-> wrote (imm :cmp :t0 -4) (branch :eq (tag prefix "cleanup-write"))
          (imm :cmp :t0 0) (branch :le (tag prefix "cleanup-done"))
          (alu :cmp :t0 :p2) (branch :hi (tag prefix "cleanup-done"))
          (alu :add :p1 :t0) (alu :sub :p2 :t0) (branch :always (tag prefix "cleanup-write"))
          (mark (tag prefix "cleanup-done"))
          (mem :ld :p1 :s0 (io/state-offset :out-message))
          (mem :ld :p2 :s0 (io/state-offset :out-message-length))
          (mem :ld :t5 :s0 (io/state-offset :out-exit))))))

;; Both public and fatal output use owned cleanup, then complete short writes.
(defn- write-and-exit [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]
                       prefix :string fd :i64]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> (cleanup-before-exit out cfg prefix fd)
                  (mark (tag prefix "write")) (imm :cmp :p2 0) (branch :eq (tag prefix "exit")))
        wrote (sys start cfg :write (io/literal fd) (io/register :p1) (io/register :p2) (io/literal 0))
        complete (-> wrote (imm :cmp :t0 -4) (branch :eq (tag prefix "write"))
                     (imm :cmp :t0 0) (branch :le (tag prefix "exit")) (alu :cmp :t0 :p2) (branch :hi (tag prefix "exit"))
                     (alu :add :p1 :t0) (alu :sub :p2 :t0) (branch :always (tag prefix "write")) (mark (tag prefix "exit")))]
    (-> (sys complete cfg :exit-group (io/register :t5) (io/literal 0) (io/literal 0) (io/literal 0))
        (append :trap :none :none :none :none :none 0 ""))))

(defn- call-guest [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]]
  [:list [:ref :linux.static/instruction]]
  (-> out (li :a1 0) (li :a2 0) (li :a3 0) (li :a4 0) (li :ctx 0)
      (li :gctx (record-get [:ref :linux.static.prelude/config] cfg :data))
      (append :call :none :none :none :none :none 0 "ls/guest-main")))

(defn- command-and-exit [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]]
  [:list [:ref :linux.static/instruction]]
  ;; Explicit internal command entry ABI. The public planner does not admit
  ;; this mode yet. The ordinary program-value printer below remains unchanged.
  ;; Out-of-domain status values trap; successful commands do not print "0".
  (let [returned (-> (call-guest out cfg) (mov :t5 :ret)
                    (imm :cmp :t5 0) (branch :lt "ls/bad")
                    (imm :cmp :t5 255) (branch :gt "ls/bad")
                    (li :p1 0) (li :p2 0))]
    (write-and-exit returned cfg "command" 1)))

(defn- guest-and-answer [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]]
  [:list [:ref :linux.static/instruction]]
  (let [data (record-get [:ref :linux.static.prelude/config] cfg :data)
        printed (-> (call-guest out cfg)
                    (mov :t4 :ret) (li :t8 0) (li :t6 (+ data 687)) (li :t7 (+ data 688))
                    (li :t0 10) (li :t1 0) (byte-op :stb :t0 :t6 :t1)
                    (imm :cmp :t4 0) (branch :ge "ls.prelude/decimal") (li :t8 1) (append :neg :none :t4 :none :none :none 0 "")
                    (mark "ls.prelude/decimal") (append :udiv10 :none :t4 :t4 :t5 :none 0 "")
                    (imm :add :t5 48) (imm :sub :t6 1) (li :t1 0) (byte-op :stb :t5 :t6 :t1)
                    (imm :cmp :t4 0) (branch :ne "ls.prelude/decimal")
                    (imm :cmp :t8 0) (branch :eq "ls.prelude/decimal-done")
                    (imm :sub :t6 1) (li :t0 45) (li :t1 0) (byte-op :stb :t0 :t6 :t1)
                    (mark "ls.prelude/decimal-done") (alu :sub :t7 :t6)
                    (mov :p1 :t6) (mov :p2 :t7) (li :t5 (exit-code cfg :ok)))]
    (if (= (key-of (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :entry-mode)) :command-i64)
      (command-and-exit out cfg)
      (write-and-exit printed cfg "answer" 1))))

(defn- signal-handler [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> out (append :align :none :none :none :none :none 16 "") (mark "ls/handler")
                  (li :t1 (record-get [:ref :linux.static.prelude/config] cfg :data))
                  (mem :ld :t0 :t1 (io/state-offset :metered)) (imm :cmp :t0 0) (branch :eq "ls.prelude/not-fuel")
                  (mem :ld :t0 :t1 (record-get [:ref :linux.static.prelude/config] cfg :fuel))
                  (imm :cmp :t0 0) (branch :eq "ls/trap-fuel") (mark "ls.prelude/not-fuel"))
        signals (loop [index 0 code start]
                  (if (= index 5) code
                    (recur (+ index 1)
                      (-> (named (-> code (imm :cmp :p0 (signal-number index))
                                     (branch :ne (tag "signal-next" (string-from-i64 index))))
                             (tag "signal-match" (string-from-i64 index)) (tag "signal-message" (string-from-i64 index))
                             (signal-message index) (exit-code cfg :trap/signal))
                          (mark (tag "signal-next" (string-from-i64 index)))))))]
    (named signals "ls.prelude/signal-unknown" "ls.prelude/unknown-message" (signal-message 5) (exit-code cfg :trap/signal))))
(defn- trap-paths [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]]
  [:list [:ref :linux.static/instruction]]
  (let [base (-> out (named "ls/trap-fuel" "ls.prelude/fuel-message" (budget-message cfg :fuel "") (exit-code cfg (trap-name cfg :fuel)))
                 (named "ls/trap-cells" "ls.prelude/cells-message" (budget-message cfg :cells " :arena :pairs") (exit-code cfg (trap-name cfg :cells)))
                 (named "ls/trap-vector-table" "ls.prelude/vector-table-message" (budget-message cfg :cells " :arena :vectors") (exit-code cfg (trap-name cfg :cells)))
                 (named "ls/trap-vector-items" "ls.prelude/vector-items-message" (budget-message cfg :cells " :arena :vector-items") (exit-code cfg (trap-name cfg :cells)))
                 (named "ls/trap-bytes" "ls.prelude/bytes-message" (budget-message cfg :bytes " :arena :string-pool") (exit-code cfg (trap-name cfg :bytes)))
                 (named "ls/trap-kgraph" "ls.prelude/kgraph-message" (budget-message cfg :cells " :arena :kgraph") (exit-code cfg (trap-name cfg :cells)))
                 (named "ls.cap/no-handler" "ls.prelude/no-handler-message" (slot-message cfg :typed-cap-call) (exit-code cfg (trap-name cfg :slot))))
        names (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :bytes-value-traps)
        values (loop [i 1 code base]
                 (if (> i (meta/value-count names)) code
                   (recur (+ i 1) (named code (byte-value-label i) (tag "byte-value-message" (string-from-i64 i))
                     (byte-value-message cfg i) (exit-code cfg :trap/signal)))))
        fatal (-> values (mark "ls/bad") (append :trap :none :none :none :none :none 0 "") (mark "ls/trap-exit"))]
    (write-and-exit fatal cfg "trap" 2)))

(defn- slot-failure [error :keyword] [:ref :linux.static.prelude/slots]
  (record-new [:ref :linux.static.prelude/slots] (empty-code) (meta/value-map) error))
(defn- slot-routines [cfg [:ref :linux.static.prelude/config] layout [:ref :form/r]] [:ref :linux.static.prelude/slots]
  (let [source-plan (record-get [:ref :linux.static.prelude/config] cfg :plan)
        slots (lookup source-plan :slots) context (lookup source-plan :context-abi)]
    (loop [index 0 code (empty-code) bindings (meta/value-map)]
      (if (>= index (meta/value-count slots)) (record-new [:ref :linux.static.prelude/slots] code bindings :ok)
        (let [pair (entry slots index) slot (key-of (item pair 0)) description (item pair 1)]
          (cond
            (not (true? (lookup description :admitted?)))
            (let [label (tag "stub" (string-from-i64 index)) message (tag "slot-message" (string-from-i64 index))
                  stub (named (append code :align :none :none :none :none :none 16 "")
                         label message (slot-message cfg slot) (exit-code cfg (trap-name cfg :slot)))]
              (recur (+ index 1) stub
                (meta/value-merge bindings (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword slot) (meta/value-string label))))))
            (= slot :typed-cap-call)
            (recur (+ index 1) code
              (meta/value-merge bindings (-> (meta/value-map)
      (meta/value-map-insert (meta/value-keyword slot) (meta/value-string "ls.cap/typed-cap-call")))))
            (meta/value-set-contains? (arena/supported-slots) (meta/value-keyword slot))
            (let [body (arena/routine context layout source-plan slot)]
              (if (not= (record-get [:ref :linux.static.arena/result] body :error) :ok)
                (slot-failure (record-get [:ref :linux.static.arena/result] body :error))
                (recur (+ index 1) (join code (record-get [:ref :linux.static.arena/result] body :code))
                  (meta/value-merge bindings (record-get [:ref :linux.static.arena/result] body :bindings)))))
            (meta/value-set-contains? (graph/supported-slots) (meta/value-keyword slot))
            (let [body (graph/routine context layout slot)]
              (if (not= (record-get [:ref :linux.static.graph/result] body :error) :ok)
                (slot-failure (record-get [:ref :linux.static.graph/result] body :error))
                (recur (+ index 1) (join code (record-get [:ref :linux.static.graph/result] body :code))
                  (meta/value-merge bindings (record-get [:ref :linux.static.graph/result] body :bindings)))))
            (meta/value-set-contains? (vectors/supported-slots) (meta/value-keyword slot))
            (let [body (vectors/routine context slot)]
              (if (not= (record-get [:ref :linux.static.vectors/result] body :error) :ok)
                (slot-failure (record-get [:ref :linux.static.vectors/result] body :error))
                (recur (+ index 1) (join code (record-get [:ref :linux.static.vectors/result] body :code))
                  (meta/value-merge bindings (record-get [:ref :linux.static.vectors/result] body :bindings)))))
            :else
            (let [body (strings/routine context slot)]
              (if (not= (record-get [:ref :linux.static.strings/result] body :error) :ok)
                (slot-failure (record-get [:ref :linux.static.strings/result] body :error))
                (recur (+ index 1) (join code (record-get [:ref :linux.static.strings/result] body :code))
                  (meta/value-merge bindings (record-get [:ref :linux.static.strings/result] body :bindings)))))))))))

(defn- constants [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.prelude/config]]
  [:list [:ref :linux.static/instruction]]
  (let [base (-> out (append :align :none :none :none :none :none 16 "")
                 (data-bytes "ls.prelude/fuel-message" (budget-message cfg :fuel ""))
                 (data-bytes "ls.prelude/cells-message" (budget-message cfg :cells " :arena :pairs"))
                 (data-bytes "ls.prelude/vector-table-message" (budget-message cfg :cells " :arena :vectors"))
                 (data-bytes "ls.prelude/vector-items-message" (budget-message cfg :cells " :arena :vector-items"))
                 (data-bytes "ls.prelude/bytes-message" (budget-message cfg :bytes " :arena :string-pool"))
                 (data-bytes "ls.prelude/kgraph-message" (budget-message cfg :cells " :arena :kgraph"))
                 (data-bytes "ls.prelude/no-handler-message" (slot-message cfg :typed-cap-call))
                 (data-bytes "ls.prelude/cleanup-message" (cleanup-message))
                 (data-bytes "ls.prelude/unknown-message" (signal-message 5)))
        signals (loop [index 0 code base]
                  (if (= index 5) code
                    (recur (+ index 1) (data-bytes code (tag "signal-message" (string-from-i64 index)) (signal-message index)))))
        names (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :bytes-value-traps)
        values (loop [i 1 code signals]
                 (if (> i (meta/value-count names)) code
                   (recur (+ i 1) (data-bytes code (tag "byte-value-message" (string-from-i64 i)) (byte-value-message cfg i)))))
        slots (lookup (record-get [:ref :linux.static.prelude/config] cfg :plan) :slots)
        messages (loop [index 0 code values]
                   (if (>= index (meta/value-count slots)) code
                     (let [pair (entry slots index)]
                       (recur (+ index 1)
                         (if (true? (lookup (item pair 1) :admitted?)) code
                           (data-bytes code (tag "slot-message" (string-from-i64 index)) (slot-message cfg (key-of (item pair 0)))))))))]
    (-> messages (append :align :none :none :none :none :none 16 "") (mark "ls/text-end"))))

(defn- exit-valid? [codes [:ref :form/r] key :keyword] :bool
  (let [n (lookup codes key)] (and (= (meta/value-kind n) :i64) (>= (i64-of n) 0) (<= (i64-of n) 255))))
(defn- byte-traps-valid? [names [:ref :form/r]] :bool
  (and (= (meta/value-kind names) :vector) (or (= (meta/value-count names) 0) (= (meta/value-count names) 11))
    (loop [i 0]
      (if (>= i (meta/value-count names)) true
        (if (= (meta/value-kind (item names i)) :keyword) (recur (+ i 1)) false)))))
(defn- configuration-error [isa :keyword source-plan [:ref :form/r] layout [:ref :form/r]] :keyword
  (let [data (i64-of (lookup layout :data)) memory (i64-of (lookup layout :memory-size))
        context (lookup source-plan :context-abi) fuel (i64-of (lookup context :fuel-offset))
        slots (lookup source-plan :slots) traps (lookup source-plan :trap-names) codes (lookup source-plan :exit-codes)]
    (cond
      (not (or (= isa :x86_64) (= isa :aarch64))) :unknown-isa
      (or (<= data 0) (not= (bit-and data 4095) 0) (< memory 4096)
          (> memory (- 9223372036854775807 data))) :layout-input
      (or (not (meta/value-equal? (lookup context :version) (meta/value-i64 11)))
          (< fuel 8) (> fuel 504) (not= (bit-and fuel 7) 0)) :fuel-offset
      (or (not= (meta/value-kind slots) :map) (not= (meta/value-kind (lookup source-plan :handlers?)) :bool)) :slot-plan
      (or (not= (meta/value-kind (lookup source-plan :vectors)) :i64)
          (not= (meta/value-kind (lookup source-plan :vector-items)) :i64)
          (not= (meta/value-kind (lookup source-plan :vector-item-limit)) :i64)
          (< (i64-of (lookup source-plan :vectors)) 0) (< (i64-of (lookup source-plan :vector-items)) 0)
          (< (i64-of (lookup source-plan :vector-item-limit)) 0)) :vector-plan
      (or (not= (meta/value-kind (lookup source-plan :byte-value-limit)) :i64)
          (not= (meta/value-kind (lookup source-plan :string-value-limit)) :i64)
          (< (i64-of (lookup source-plan :byte-value-limit)) 0) (< (i64-of (lookup source-plan :string-value-limit)) 0)
          (not (byte-traps-valid? (lookup source-plan :bytes-value-traps)))) :bytes-plan
      (not (and (exit-valid? codes :ok) (exit-valid? codes :trap/signal))) :exit-code
      :else
      (let [traps-valid? (loop [index 0]
                           (if (= index 4) true
                             (let [key (case index 0 :fuel 1 :cells 2 :bytes :slot) name (lookup traps key)]
                               (if (and (= (meta/value-kind name) :keyword) (exit-valid? codes (key-of name)))
                                 (recur (+ index 1)) false))))]
        (if (not traps-valid?) :trap-profile
          (loop [index 0]
            (if (>= index (meta/value-count slots)) :ok
              (let [pair (entry slots index) slot (item pair 0) description (item pair 1)
                    offset (i64-of (lookup description :offset)) admitted (lookup description :admitted?)]
                (cond
                  (or (not= (meta/value-kind slot) :keyword) (not= (meta/value-kind description) :map)
                      (< offset 8) (> offset 504) (not= (bit-and offset 7) 0) (not= (meta/value-kind admitted) :bool)) :slot-plan
                  (and (true? admitted) (= (key-of slot) :typed-cap-call) (not (true? (lookup source-plan :handlers?)))) :handlers-not-planned
                  (and (true? admitted) (meta/value-set-contains? (vectors/supported-slots) slot)
                       (or (< (i64-of (lookup source-plan :vectors)) 1) (< (i64-of (lookup source-plan :vector-items)) 1)
                           (< (i64-of (lookup source-plan :vector-item-limit)) 1))) :vector-plan
                  (and (true? admitted) (meta/value-set-contains? (vectors/supported-byte-slots) slot)
                       (or (< (i64-of (lookup source-plan :byte-value-limit)) 1) (< (i64-of (lookup source-plan :string-value-limit)) 1)
                           (not= (meta/value-count (lookup source-plan :bytes-value-traps)) 11))) :bytes-plan
                  (and (true? admitted) (not= (key-of slot) :typed-cap-call)
                       (not (meta/value-set-contains? (strings/supported-slots) slot))
                       (not (meta/value-set-contains? (vectors/supported-slots) slot))
                       (not (meta/value-set-contains? (graph/supported-slots) slot))
                       (not (meta/value-set-contains? (arena/supported-slots) slot))) :admitted-slot-unimplemented
                  :else (recur (+ index 1)))))))))))
(defn- failure [error :keyword] [:ref :linux.static.prelude/result]
  (record-new [:ref :linux.static.prelude/result] (empty-code) (meta/value-map) (meta/value-set) error))

(defn routine [isa :keyword source-plan [:ref :form/r] layout [:ref :form/r]] [:ref :linux.static.prelude/result]
  (let [error (configuration-error isa source-plan layout)]
    (if (not= error :ok) (failure error)
      (let [cfg (record-new [:ref :linux.static.prelude/config] isa (i64-of (lookup layout :data))
                  (i64-of (lookup (lookup source-plan :context-abi) :fuel-offset)) source-plan)
            slots (slot-routines cfg layout)]
        (if (not= (record-get [:ref :linux.static.prelude/slots] slots :error) :ok)
          (failure (record-get [:ref :linux.static.prelude/slots] slots :error))
          (if (true? (lookup source-plan :handlers?))
            (let [caps (capability/routine isa source-plan layout)
                  owned (owned-output/routine isa layout)]
              (if (not= (record-get [:ref :linux.static.capability/result] caps :error) :ok)
                (failure (record-get [:ref :linux.static.capability/result] caps :error))
                (if (not= (record-get [:ref :linux.static.output/result] owned :error) :ok)
                  (failure (record-get [:ref :linux.static.output/result] owned :error))
                  (let [body (-> (startup cfg) (join (record-get [:ref :linux.static.capability/result] caps :start))
                               (guest-and-answer cfg) (signal-handler cfg) (trap-paths cfg)
                               (join (record-get [:ref :linux.static.prelude/slots] slots :code))
                               (join (record-get [:ref :linux.static.output/result] owned :code))
                               (join (record-get [:ref :linux.static.capability/result] caps :code)) (constants cfg))]
                  (record-new [:ref :linux.static.prelude/result] body
                    (record-get [:ref :linux.static.prelude/slots] slots :bindings)
                    (-> (meta/value-set)
      (meta/value-set-conj (meta/value-string "ls/guest-main"))
      (meta/value-set-conj (meta/value-string "ls.cap/c1-cap"))
      (meta/value-set-conj (meta/value-string "ls.cap/c1-decide"))
      (meta/value-set-conj (meta/value-string "ls.cap/h-decide"))) :ok)))))
            (let [body (-> (startup cfg) (guest-and-answer cfg) (signal-handler cfg) (trap-paths cfg)
                           (join (record-get [:ref :linux.static.prelude/slots] slots :code)) (constants cfg))]
              (record-new [:ref :linux.static.prelude/result] body
                (record-get [:ref :linux.static.prelude/slots] slots :bindings)
                (-> (meta/value-set)
      (meta/value-set-conj (meta/value-string "ls/guest-main"))) :ok))))))))
