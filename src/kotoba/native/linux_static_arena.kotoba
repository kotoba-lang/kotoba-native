;; Structural scalar arena-scope, context ABI v6/v11. Preserve the original
;; 256-deep LIFO bound and the four allocator checkpoints. No grants/effects.
(ns kotoba.native.linux-static-arena
  {:kotoba/export [supported-slots routine]}
  (:require [kotoba.artifact.data :as meta] [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-io :as io])
  (:schemas {:linux.static.arena/result
    [:record :linux.static.arena/result [[:code [:list [:ref :linux.static/instruction]]]
                                      [:bindings [:ref :form/r]] [:error :keyword]]]}))
(defn supported-slots [] [:ref :form/r]
  (-> (meta/value-set) (meta/value-set-conj (meta/value-keyword :arena-enter))
      (meta/value-set-conj (meta/value-keyword :arena-leave))))
(defn- empty-code [] [:list [:ref :linux.static/instruction]] (typed-list-new [:list [:ref :linux.static/instruction]]))
(defn- ins [out [:list [:ref :linux.static/instruction]] op :keyword aux :keyword d :keyword s :keyword b :keyword n :i64 target :string]
  [:list [:ref :linux.static/instruction]]
  (typed-list-conj [:list [:ref :linux.static/instruction]] out (asm/instruction op aux d s b :none n target (vector-alloc 0))))
(defn- mem [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword b :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (ins out op :none d :none b n ""))
(defn- imm [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (ins out :alui op d :none :none n ""))
(defn- branch [out [:list [:ref :linux.static/instruction]] condition :keyword target :string]
  [:list [:ref :linux.static/instruction]] (ins out :bcc condition :none :none :none 0 target))
(defn- counter [index :i64] :i64
  (io/state-offset (case index 0 :pair-used 1 :pool-used 2 :vector-used :vector-item-used)))
(defn- position [out [:list [:ref :linux.static/instruction]] base :i64] [:list [:ref :linux.static/instruction]]
  (-> out (ins :mov :none :t1 :t0 :none 0 "") (ins :shli :none :t1 :none :none 5 "")
      (ins :li :none :t2 :none :none base "") (ins :alu :add :t1 :t2 :none 0 "")))
(defn- start [name :string] [:list [:ref :linux.static/instruction]]
  (-> (empty-code) (ins :align :none :none :none :none 16 "")
      (ins :label :none :none :none :none 0 name)
      (mem :ld :t0 :ctx 0) (imm :cmp :t0 11) (branch :ne "ls/bad")
      (mem :ld :t0 :ctx (io/state-offset :arena-depth))))
(defn- done [out [:list [:ref :linux.static/instruction]]] [:list [:ref :linux.static/instruction]]
  (-> out (mem :st :t0 :ctx (io/state-offset :arena-depth))
      (ins :li :none :ret :none :none 0 "") (ins :ret :none :none :none :none 0 "")))
(defn- enter-code [base :i64] [:list [:ref :linux.static/instruction]]
  (let [begin (position (-> (start "ls.arena/enter") (imm :cmp :t0 256) (branch :hs "ls/bad")) base)
        saved (loop [index 0 out begin]
                (if (= index 4) out
                  (recur (+ index 1) (-> out (mem :ld :t2 :ctx (counter index)) (mem :st :t2 :t1 (* index 8))))))]
    (done (imm saved :add :t0 1))))
(defn- leave-code [base :i64] [:list [:ref :linux.static/instruction]]
  (let [begin (position (-> (start "ls.arena/leave") (imm :cmp :t0 0) (branch :eq "ls/bad")
                            (imm :cmp :t0 256) (branch :hi "ls/bad") (imm :sub :t0 1)) base)
        checked (loop [index 0 out begin]
                  (if (= index 4) out
                    (recur (+ index 1) (-> out (mem :ld :t2 :t1 (* index 8)) (mem :ld :t3 :ctx (counter index))
                                           (ins :alu :cmp :t2 :t3 :none 0 "") (branch :hi "ls/bad")))))
        restored (loop [index 0 out checked]
                   (if (= index 4) out
                     (recur (+ index 1) (-> out (mem :ld :t2 :t1 (* index 8)) (mem :st :t2 :ctx (counter index))))))]
    ;; No counter or depth changes until every checkpoint has been validated.
    (done restored)))
(defn- get-i64 [value [:ref :form/r] key :keyword] :i64
  (option-match [:option [:ref :form/r]] (meta/value-get value (meta/value-keyword key)) -1
    item (option-value-of [:option :i64] (meta/value-i64-value item) -1)))
(defn routine [context [:ref :form/r] layout [:ref :form/r] source-plan [:ref :form/r] slot :keyword]
  [:ref :linux.static.arena/result]
  (let [base (get-i64 layout :arena-marks) data (get-i64 layout :data) size (get-i64 layout :memory-size)
        pool (get-i64 layout :pool) bytes (get-i64 source-plan :bytes)
        name (if (= slot :arena-enter) "ls.arena/enter" "ls.arena/leave")]
    (if (or (not (meta/value-set-contains? (supported-slots) (meta/value-keyword slot)))
            (not= (get-i64 context :version) 11) (< data 1) (< size 8192) (< pool data) (< bytes 0)
            (> size (- 9223372036854775807 data)) (> bytes (- 9223372036854775807 pool))
            (< base (+ pool bytes)) (> base (- (+ data size) 8192)) (not= (bit-and base 15) 0))
      (record-new [:ref :linux.static.arena/result] (empty-code) (meta/value-map) :arena-layout)
      (record-new [:ref :linux.static.arena/result] (if (= slot :arena-enter) (enter-code base) (leave-code base))
        (meta/value-map-insert (meta/value-map) (meta/value-keyword slot) (meta/value-string name)) :ok))))
