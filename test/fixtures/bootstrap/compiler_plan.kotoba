;; Pure correctness probes carry no capability effects or grants. The
;; compiler's filesystem/CLI authority must not leak into benchmark guests.
(defn pure-plan [scope :string] [:ref :form/r]
  (let [base (compiler-plan scope (bytes-empty) (bytes-empty))
        old-slots (option-value-of [:option [:ref :form/r]]
                    (meta/value-get base (meta/value-keyword :slots)) (meta/value-map))
        slots (meta/value-assoc old-slots (meta/value-keyword :typed-cap-call)
                (-> (meta/value-map)
                    (meta/value-map-insert (meta/value-keyword :offset) (meta/value-i64 128))
                    (meta/value-map-insert (meta/value-keyword :admitted?) (meta/value-bool false))))]
    (-> base
        (meta/value-assoc (meta/value-keyword :slots) slots)
        (meta/value-assoc (meta/value-keyword :handlers?) (meta/value-bool false))
        (meta/value-assoc (meta/value-keyword :grant) (meta/value-vector))
        (meta/value-assoc (meta/value-keyword :effect-ids) (meta/value-vector)))))

;; The seal/SHA fixture actually calls wire 3. Grant exactly that capability.
(defn hash-plan [scope :string c1 :bytes c3 :bytes] [:ref :form/r]
  (let [base (compiler-plan scope c1 c3)
        ids (meta/value-vector-conj (meta/value-vector) (meta/value-i64 3))]
    (-> base
        (meta/value-assoc (meta/value-keyword :grant) ids)
        (meta/value-assoc (meta/value-keyword :effect-ids) ids))))
