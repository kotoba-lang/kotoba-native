))
  (meta/value-map-insert (meta/value-keyword :fuel) (meta/value-i64 9007199254740991))
  (meta/value-map-insert (meta/value-keyword :grant) (-> (meta/value-vector) (meta/value-vector-conj (meta/value-i64 35)) (meta/value-vector-conj (meta/value-i64 37)) (meta/value-vector-conj (meta/value-i64 38)) (meta/value-vector-conj (meta/value-i64 39))))
